<% p = @pedido %>
<div class="ticket">
  <div class="centro"><strong>PEDIDO <%= p.folio %></strong></div>
  <div class="centro">para <%= p.destino %> · surte <%= p.sucursal_origen %></div>
  <div class="centro">pidió <%= p.usuario %> · <%= l p.created_at, format: :short %></div>
  <div class="centro">estado: <%= p.estado %></div>
  <% if p.notas.present? %><div>Notas: <%= p.notas %></div><% end %>
  <div class="linea"></div>
  <table>
    <tr><td><strong>Producto</strong></td><td class="der"><strong>Pide</strong></td><td class="der"><strong>Lleva</strong></td></tr>
    <% p.lineas.each do |l| %>
      <% d = l.producto.decimales %>
      <tr>
        <td><%= l.producto.nombre %><%= " (#{l.estado == 'no_surtir' ? "no surtir: #{l.motivo}" : l.estado})" unless l.pendiente? %></td>
        <td class="der"><%= number_with_precision(l.cantidad, precision: d) %> <%= l.producto.unidad %></td>
        <td class="der"><%= number_with_precision(l.cantidad_surtida, precision: d) %></td>
      </tr>
    <% end %>
  </table>
  <div class="linea"></div>
  <% salidas = Salida.where(id: SalidaEtiqueta.where(etiqueta_id: Etiqueta.where(pedido_linea_id: p.lineas.map(&:id)).select(:id)).select(:salida_id)).order(:created_at) %>
  <% if salidas.any? %><div>Salidas: <%= salidas.map { |s| "#{s.folio} (#{s.estado})" }.join(", ") %></div><% end %>
  <div><%= p.lineas.size %> renglones · <%= p.lineas.count { |l| l.estado == "surtido" } %> surtidos</div>
</div>

<div class="ticket hoja">
  <div class="centro"><strong><%= t("pedidos.pendientes_por_surtir").upcase %></strong></div>
  <div class="centro"><%= sucursal_actual %> · <%= l Time.current, format: :short %></div>
  <div class="linea"></div>
  <% if @pendientes.empty? %>
    <div class="centro"><%= t("pedidos.nada_pendiente") %></div>
  <% else %>
    <table>
      <% @pendientes.each do |producto, falta, pedidos| %>
        <tr><td><strong><%= producto.nombre %></strong></td><td class="der"><strong><%= number_with_precision(falta, precision: producto.decimales) %> <%= producto.unidad %></strong></td></tr>
        <tr><td colspan="2"><%= pedidos.map { |p| "#{p.folio} #{p.destino}" }.join(" · ") %></td></tr>
      <% end %>
    </table>
    <div class="linea"></div>
    <div><%= @pendientes.size %> <%= t("pedidos.productos") %> · <%= @pendientes.flat_map { |_, _, ps| ps }.uniq.size %> <%= t("pedidos.pedidos").downcase %></div>
  <% end %>
</div>

<h1 class="mb-4 text-2xl font-bold"><%= sucursal_actual.matriz? ? t("pedidos.nuevo") : t("pedidos.nuevo_a_matriz") %></h1>
<%= form_with model: @pedido, url: pedidos_path, data: { controller: "lineas" }, class: "formulario" do |f| %>
  <div class="campos">
    <% if sucursal_actual.matriz? %>
      <div>
        <%= f.label :destino, t("pedidos.para"), class: "block text-sm font-medium" %>
        <%= f.select :destino, grouped_options_for_select({ t("pedidos.tiendas") => @destinos.map { |s| [ s.nombre, "sucursal:#{s.id}" ] }, t("pedidos.clientes_de_ruta") => @clientes.map { |c| [ "#{c.nombre}#{" · #{c.ruta}" if c.ruta}", "cliente:#{c.id}" ] } }), {}, class: "entrada" %>
      </div>
    <% else %>
      <p class="text-base"><%= t("pedidos.para") %> <strong><%= sucursal_actual %></strong></p>
    <% end %>
    <div class="md:col-span-2">
      <%= f.label :notas, t("comun.notas"), class: "block text-sm font-medium" %>
      <%= f.text_field :notas, class: "entrada" %>
    </div>
  </div>
  <div class="rounded-lg border border-stone-200 p-4">
    <% if @sugerido.present? %><p class="mb-2 rounded bg-marca-50 px-3 py-2 text-sm"><%= t("pedidos.sugerido_aviso", count: @sugerido.size) %></p><% end %>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("comun.producto") %></th><th class="w-48 py-1"><%= t("comun.cantidad") %></th><th class="w-10"></th></tr></thead>
      <tbody data-lineas-target="cuerpo">
        <%= f.fields_for :lineas do |l| %>
          <tr data-lineas-target="fila">
            <td class="py-1 pr-2"><%= l.collection_select :producto_id, Producto.activos.order(:nombre), :id, ->(p) { "#{p.nombre} (#{p.unidad})" }, { include_blank: "—" }, class: "entrada mt-0" %></td>
            <td class="py-1 pr-2"><%= l.number_field :cantidad, step: "0.001", min: "0.001", class: "entrada mt-0 font-mono" %></td>
            <td class="py-1"><button type="button" data-action="lineas#quitar" class="btn btn-ghost-danger btn-sm"><i class="bi bi-x-lg"></i></button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <button type="button" data-action="lineas#agregar" class="btn btn-secondary mt-3">+ <%= t("pedidos.renglon") %></button>
  </div>
  <%= f.submit t("pedidos.enviar_pedido"), class: "btn btn-primary btn-lg" %>
<% end %>

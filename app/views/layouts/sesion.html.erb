<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= usuario_actual&.tema || "sistema" %>" data-densidad="<%= usuario_actual&.densidad || "normal" %>" data-letra="<%= usuario_actual&.letra || "normal" %>">
  <head>
    <meta charset="utf-8">
    <title>Kobayashi</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-fondo text-stone-900 flex items-center justify-center">
    <%= yield %>
  </body>
</html>

<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Kobayashi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kobayashi">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-fondo text-stone-900" data-controller="dialogo">
    <%= render "layouts/ribbon" %>
    <%= render "layouts/acerca" %>
    <% if flash[:notice] || flash[:alert] %>
      <div class="w-full px-4 pt-4">
        <% if flash[:notice] %><p class="rounded bg-green-50 px-3 py-2 text-sm text-green-800"><%= flash[:notice] %></p><% end %>
        <% if flash[:alert] %><p class="rounded bg-red-50 px-3 py-2 text-sm text-red-800"><%= flash[:alert] %></p><% end %>
      </div>
    <% end %>
    <main class="w-full overflow-x-auto px-4 py-4">
      <%= yield %>
    </main>
  </body>
</html>

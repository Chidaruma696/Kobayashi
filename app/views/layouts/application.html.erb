<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Kobayashi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kobayashi">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900">
    <header class="bg-slate-900 text-white">
      <nav class="mx-auto flex max-w-6xl items-center gap-6 px-5 py-3 text-sm">
        <%= link_to "Kobayashi", root_path, class: "text-lg font-bold" %>
        <span class="text-slate-300"><%= sucursal_actual %></span>
        <span class="ml-auto text-slate-300"><%= usuario_actual %></span>
        <%= button_to "Salir", salir_path, method: :delete, class: "rounded bg-slate-700 px-3 py-1 hover:bg-slate-600" %>
      </nav>
    </header>
    <% if flash[:notice] || flash[:alert] %>
      <div class="mx-auto max-w-6xl px-5 pt-4">
        <% if flash[:notice] %><p class="rounded bg-green-50 px-3 py-2 text-sm text-green-800"><%= flash[:notice] %></p><% end %>
        <% if flash[:alert] %><p class="rounded bg-red-50 px-3 py-2 text-sm text-red-800"><%= flash[:alert] %></p><% end %>
      </div>
    <% end %>
    <main class="mx-auto max-w-6xl px-5 py-6">
      <%= yield %>
    </main>
  </body>
</html>

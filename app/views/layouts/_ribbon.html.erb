<% activa = pestana_activa %>
<div class="bg-slate-900 text-white">
  <nav class="flex w-full flex-wrap items-end gap-1 px-4 pt-2 text-sm">
    <%= link_to "Kobayashi", root_path, class: "mr-4 pb-2 text-lg font-bold" %>
    <% pestanas_visibles.each do |p| %>
      <%= link_to p[:nombre], ruta_de_pestana(p),
            class: "rounded-t px-4 py-2 #{p[:id] == activa[:id] ? 'bg-slate-100 text-slate-900 font-semibold' : 'text-slate-300 hover:bg-slate-800'}" %>
    <% end %>
    <span class="ml-auto pb-2 text-slate-300"><%= sucursal_actual %> · <%= usuario_actual %></span>
    <%= button_to "Salir", salir_path, method: :delete, class: "mb-1 ml-3 rounded bg-slate-700 px-3 py-1 hover:bg-slate-600" %>
  </nav>
</div>
<div class="border-b border-slate-300 bg-slate-100">
  <div class="flex w-full flex-wrap gap-x-6 gap-y-2 px-4 py-2">
    <% activa[:grupos].each do |g| %>
      <% botones = g[:botones].select { |b| boton_visible?(b) } %>
      <% next if botones.empty? %>
      <div class="flex flex-col items-center border-r border-slate-300 pr-6 last:border-0">
        <div class="flex gap-1">
          <% botones.each do |b| %>
            <% ruta = send(b.ruta) %>
            <%= link_to ruta, class: "flex w-20 flex-col items-center rounded px-1 py-1 text-center text-xs hover:bg-slate-200 #{'bg-white shadow-sm' if current_page?(ruta)}" do %>
              <span class="text-2xl leading-8"><%= b.icono %></span>
              <span class="leading-tight"><%= b.nombre %></span>
            <% end %>
          <% end %>
        </div>
        <span class="mt-1 text-[10px] uppercase tracking-wide text-slate-500"><%= g[:nombre] %></span>
      </div>
    <% end %>
  </div>
</div>

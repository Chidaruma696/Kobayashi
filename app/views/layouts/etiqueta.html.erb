<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || t("cinta.pestanas.etiquetas") %></title>
    <style>
      @page { size: <%= @ancho %>mm <%= @alto %>mm; margin: 0; }
      body { margin: 0; font-family: Arial, sans-serif; color: #000; }
      .etiqueta { width: <%= @ancho %>mm; height: <%= @alto %>mm; box-sizing: border-box; padding: 2mm 3mm; display: flex; flex-direction: column; align-items: center; justify-content: space-between; overflow: hidden; page-break-after: always; page-break-inside: avoid; }
      .etiqueta:last-of-type { page-break-after: auto; }
      .leyenda { font-size: 9px; font-weight: 600; width: 100%; text-align: center; }
      .nombre { font-size: <%= @letra_nombre %>px; font-weight: bold; line-height: 1.12; width: 100%; text-align: center; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .nombre .tipo { display: block; font-size: 0.8em; letter-spacing: .5px; }
      .bc { flex: 1; display: flex; align-items: center; justify-content: center; width: 100%; }
      .bc svg { max-width: 100%; height: auto; max-height: 100%; }
      .bc .texto { font-family: monospace; font-size: 12px; }
      .pie { display: flex; justify-content: space-between; width: 100%; font-size: 9pt; align-items: baseline; }
      .cantidad { font-size: 16pt; font-weight: 800; }
      @media screen { body { background: #ddd; padding: 20px; } .etiqueta { background: white; box-shadow: 0 0 4px #999; margin-bottom: 12px; } .acciones { margin-top: 12px; } }
      @media print { .acciones { display: none; } }
    </style>
  </head>
  <body>
    <%= yield %>
    <div class="acciones">
      <button onclick="window.print()"><%= t("comun.imprimir") %></button>
      <a href="<%= new_etiqueta_path(producto_id: @etiqueta&.producto_id) %>"><%= t("etiquetas.volver_a_etiquetar") %></a>
    </div>
    <% if params[:imprimir] %><script>window.addEventListener("load", () => window.print());</script><% end %>
  </body>
</html>

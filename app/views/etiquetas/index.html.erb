<h1 class="mb-4 text-2xl font-bold"><%= t("etiquetas.vivas") %> · <%= sucursal_actual %></h1>
<div class="grid gap-6 lg:grid-cols-3">
  <%= form_with url: cerrar_caja_etiquetas_path, class: "card" do |f| %>
    <h2 class="mb-2 flex items-center justify-between font-semibold"><%= t("etiquetas.paquetes_sueltos") %> <span class="text-sm font-normal text-stone-500"><%= @paquetes.size %></span></h2>
    <ul class="max-h-96 overflow-auto text-sm">
      <% @paquetes.each do |e| %>
        <li class="flex items-center gap-2 border-t border-stone-100 py-1">
          <%= check_box_tag "ids[]", e.id, false, id: "p#{e.id}" %>
          <label for="p<%= e.id %>" class="flex-1 truncate"><%= e.producto.nombre %> · <span class="font-mono"><%= number_with_precision(e.cantidad, precision: e.producto.decimales) %></span></label>
          <span class="font-mono text-xs text-stone-500"><%= e.codigo %></span>
        </li>
      <% end %>
    </ul>
    <%= f.submit t("etiquetas.cerrar_caja_marcados"), class: "btn btn-primary mt-3" %>
  <% end %>
  <%= form_with url: armar_tarima_etiquetas_path, class: "card" do |f| %>
    <h2 class="mb-2 flex items-center justify-between font-semibold"><%= t("etiquetas.cajas") %> <span class="text-sm font-normal text-stone-500"><%= @cajas.size %></span></h2>
    <ul class="max-h-96 overflow-auto text-sm">
      <% @cajas.each do |e| %>
        <li class="flex items-center gap-2 border-t border-stone-100 py-1">
          <%= check_box_tag "ids[]", e.id, false, id: "c#{e.id}" %>
          <label for="c<%= e.id %>" class="flex-1 truncate"><%= e.producto&.nombre || t("etiquetas.mixta") %> · <span class="font-mono"><%= number_with_precision(e.cantidad, precision: e.producto&.decimales || 3) %></span></label>
          <%= link_to e.codigo, etiqueta_path(e), target: "_blank", class: "chip-folio text-xs" %>
        </li>
      <% end %>
    </ul>
    <%= f.submit t("etiquetas.armar_tarima_marcadas"), class: "btn btn-primary mt-3" %>
  <% end %>
  <div class="card">
    <h2 class="mb-2 flex items-center justify-between font-semibold"><%= t("etiquetas.tarimas") %> <span class="text-sm font-normal text-stone-500"><%= @tarimas.size %></span></h2>
    <ul class="text-sm">
      <% @tarimas.each do |e| %>
        <li class="flex items-center gap-2 border-t border-stone-100 py-1">
          <span class="flex-1"><%= t("etiquetas.n_cajas", count: e.hijas.size) %> · <span class="font-mono"><%= number_with_precision(e.cantidad, precision: 3) %></span></span>
          <%= link_to e.codigo, etiqueta_path(e), target: "_blank", class: "chip-folio text-xs" %>
        </li>
      <% end %>
    </ul>
    <h2 class="mb-2 mt-6 font-semibold"><%= t("etiquetas.dar_de_baja") %></h2>
    <%= form_with url: "#", data: { controller: "baja" }, class: "space-y-2 text-sm" do |f| %>
      <%= text_field_tag :codigo, nil, placeholder: t("etiquetas.escanea_codigo"), class: "w-full rounded border border-stone-300 px-2 py-1 font-mono", data: { baja_target: "codigo" } %>
      <%= text_field_tag :motivo, nil, placeholder: t("etiquetas.motivo_baja"), required: true, class: "w-full rounded border border-stone-300 px-2 py-1", data: { baja_target: "motivo" } %>
      <button type="button" data-action="baja#enviar" class="btn btn-danger btn-sm"><%= t("etiquetas.dar_de_baja") %></button>
    <% end %>
  </div>
</div>

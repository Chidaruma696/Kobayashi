<div data-controller="etiquetadora"
     data-etiquetadora-lote-url-value="<%= lote_etiquetas_path %>"
     data-etiquetadora-productos-url-value="<%= productos_etiquetas_path %>"
     data-etiquetadora-imprimir-url-value="<%= imprimir_etiquetas_path %>"
     data-etiquetadora-etiquetas-url-value="<%= etiquetas_path %>"
     data-etiquetadora-admin-productos-url-value="<%= admin_productos_path %>"
     data-etiquetadora-pedido-linea-id-value="<%= @linea&.id %>"
     data-etiquetadora-produccion-id-value="<%= @produccion&.id %>"
     data-etiquetadora-producto-value="<%= @producto_json.to_json if @producto_json %>"
     data-etiquetadora-simulada-value="<%= params[:simulada].present? %>">

  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">Etiquetar · <%= sucursal_actual %></h1>
    <div class="flex items-center gap-2">
      <% if params[:simulada].present? %>
        <button type="button" data-action="etiquetadora#simular" class="rounded bg-amber-500 px-3 py-1 text-sm text-white">simular pesada</button>
      <% end %>
      <button type="button" data-action="etiquetadora#alternarBascula" data-etiquetadora-target="btnBascula"
              class="rounded border border-red-700 px-3 py-1 text-sm text-red-700 hover:bg-red-50">Conectar báscula</button>
    </div>
  </div>

  <%= render "contexto", linea: @linea, produccion: @produccion %>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <div id="aviso" data-etiquetadora-target="aviso" class="empty:hidden rounded bg-red-50 px-3 py-2 text-sm text-red-800"></div>

      <%# Producto: buscador, ficha con chips y, plegado, el código de fábrica %>
      <div class="rounded bg-white p-4 shadow-sm">
        <div class="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500">Producto</div>
        <div class="relative">
          <input type="text" autocomplete="off" placeholder="Nombre, clave, PLU o escanea su código"
                 class="w-full rounded border border-slate-300 px-3 py-3 text-lg"
                 data-etiquetadora-target="buscador"
                 data-action="input->etiquetadora#buscar focus->etiquetadora#buscar blur->etiquetadora#ocultarResultados keydown->etiquetadora#teclaBuscador">
          <div class="absolute left-0 right-0 top-full z-30 mt-1 hidden max-h-80 overflow-y-auto rounded border border-slate-300 bg-white shadow-lg" data-etiquetadora-target="resultados"></div>
        </div>
        <div class="mt-3 hidden flex-wrap items-center gap-2 text-sm" data-etiquetadora-target="ficha"></div>
        <% if puede?("admin.catalogo") %>
          <details class="mt-3 hidden text-sm" data-etiquetadora-target="fabrica">
            <summary class="cursor-pointer text-xs font-bold uppercase tracking-wide text-slate-500">Código de fábrica y peso fijo</summary>
            <div class="mt-2 flex flex-wrap items-end gap-2">
              <label class="flex-1 text-xs text-slate-600">Código de fábrica
                <input type="text" autocomplete="off" placeholder="Escanear o teclear…" class="mt-1 w-full rounded border border-slate-300 px-2 py-1 font-mono text-sm" data-etiquetadora-target="codigoNuevo" data-action="keydown.enter->etiquetadora#vincular">
              </label>
              <label class="w-36 text-xs text-slate-600">Peso por pieza (kg)
                <input type="number" step="0.001" min="0" placeholder="ej. 0.200" class="mt-1 w-full rounded border border-slate-300 px-2 py-1 font-mono text-sm" data-etiquetadora-target="pesoFijoInput" data-action="keydown.enter->etiquetadora#vincular">
              </label>
              <button type="button" data-action="etiquetadora#vincular" class="rounded bg-amber-500 px-3 py-1 text-sm font-semibold text-white hover:bg-amber-400">Vincular</button>
            </div>
            <ul class="mt-2 space-y-1" data-etiquetadora-target="codigosLista"></ul>
            <p class="mt-1 text-xs text-slate-500">Vincula el código que trae de fábrica para que la caja lo reconozca al escanear. Si el fabricante lo cambia, agrega el nuevo: todos escanean este producto.</p>
          </details>
        <% end %>
      </div>

      <%# Pesadas (kg) %>
      <div class="hidden rounded bg-white p-4 shadow-sm" data-etiquetadora-target="panelKg">
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Una pesada</div>
            <div class="mt-1 flex flex-wrap gap-2">
              <input type="number" step="0.001" min="0.001" placeholder="kg" class="w-32 rounded border border-slate-300 px-2 py-2 font-mono" data-etiquetadora-target="manual" data-action="keydown.enter->etiquetadora#agregarManual">
              <button type="button" data-action="etiquetadora#agregarManual" class="rounded bg-slate-900 px-3 py-2 text-white hover:bg-slate-700">Agregar</button>
              <button type="button" data-action="etiquetadora#capturar" disabled class="rounded border border-emerald-700 px-3 py-2 text-emerald-800 disabled:opacity-40" data-etiquetadora-target="btnCapturar" title="Toma el peso que marca la báscula ahora">De la báscula</button>
            </div>
            <p class="mt-1 text-xs text-slate-500">Con la báscula conectada cada peso estable entra solo.</p>
            <div class="mt-2 rounded-lg border-2 border-slate-300 bg-slate-900 px-4 py-3 text-center font-mono">
              <div class="text-4xl font-extrabold leading-none text-slate-500" data-etiquetadora-target="peso">0.000</div>
              <div class="mt-1 text-xs text-slate-400" data-etiquetadora-target="estado">Desconectada</div>
            </div>
          </div>
          <div>
            <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Varias iguales</div>
            <div class="mt-1 flex items-center gap-2">
              <input type="number" step="1" min="1" value="10" class="w-16 rounded border border-slate-300 px-2 py-2 font-mono" data-etiquetadora-target="qn" data-action="input->etiquetadora#recalcularQuick keydown.enter->etiquetadora#agregarVarias">
              <span>×</span>
              <input type="number" step="0.001" min="0.001" placeholder="kg c/u" class="w-28 rounded border border-slate-300 px-2 py-2 font-mono" data-etiquetadora-target="qpeso" data-action="input->etiquetadora#recalcularQuick keydown.enter->etiquetadora#agregarVarias">
              <button type="button" data-action="etiquetadora#agregarVarias" class="rounded bg-slate-900 px-3 py-2 text-white hover:bg-slate-700">Agregar</button>
            </div>
            <label class="mt-1 flex items-center gap-2 text-xs text-slate-500">o reparte un total de
              <input type="number" step="0.001" min="0.001" placeholder="kg" class="w-24 rounded border border-slate-300 px-2 py-1 font-mono" data-etiquetadora-target="qtotal" data-action="input->etiquetadora#recalcularQuick keydown.enter->etiquetadora#agregarVarias">
              <span data-etiquetadora-target="qhint"></span>
            </label>
          </div>
        </div>
      </div>

      <%# Piezas %>
      <div class="hidden rounded bg-white p-4 shadow-sm" data-etiquetadora-target="panelPieza">
        <div class="flex flex-wrap items-end gap-3">
          <label class="text-sm">Piezas
            <input type="number" step="1" min="1" value="12" class="ml-2 w-24 rounded border border-slate-300 px-2 py-2 font-mono" data-etiquetadora-target="piezas" data-action="input->etiquetadora#pintarLista keydown.enter->etiquetadora#registrar">
          </label>
          <span class="text-sm text-slate-500" data-etiquetadora-target="piezaNota"></span>
          <button type="button" class="hidden rounded border border-slate-300 px-3 py-2 text-sm" data-etiquetadora-target="btnCopias" data-action="etiquetadora#copiasProveedor" title="Imprime N etiquetas con el código de proveedor, sin registrar nada">Solo imprimir copias del código</button>
        </div>
      </div>

      <%# Lista + acción %>
      <div class="hidden rounded bg-white shadow-sm" data-etiquetadora-target="panelLista">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
          <div class="font-semibold" data-etiquetadora-target="resumen">Sin pesadas</div>
          <div class="flex flex-wrap items-center gap-4 text-sm">
            <label class="flex items-center gap-1"><input type="checkbox" data-etiquetadora-target="enCaja" data-action="etiquetadora#guardarPrefs etiquetadora#pintarLista"> Cerrar en caja</label>
            <label class="flex items-center gap-1" data-etiquetadora-target="alVueloLabel"><input type="checkbox" data-etiquetadora-target="alVuelo" data-action="etiquetadora#guardarPrefs"> Imprimir al vuelo</label>
          </div>
        </div>
        <div class="max-h-96 overflow-y-auto">
          <table class="w-full text-sm">
            <thead class="bg-slate-100 text-left text-xs uppercase text-slate-500"><tr><th class="px-4 py-1">#</th><th class="px-2 py-1">Origen</th><th class="px-2 py-1 text-right">Cantidad</th><th class="px-2 py-1">Código</th><th></th></tr></thead>
            <tbody data-etiquetadora-target="lista"></tbody>
          </table>
        </div>
        <% if @linea.nil? && @produccion.nil? %>
          <div class="flex flex-wrap gap-3 border-t border-slate-200 px-4 py-3 text-sm">
            <input type="text" placeholder="Motivo (obligatorio: no hay pedido ni producción)" class="flex-1 rounded border border-slate-300 px-2 py-1" data-etiquetadora-target="justificacion">
            <input type="password" placeholder="PIN de quien autoriza (opcional)" inputmode="numeric" autocomplete="off" class="w-52 rounded border border-slate-300 px-2 py-1" data-etiquetadora-target="pin">
            <span class="w-full text-xs text-slate-500">Sin PIN se etiqueta igual y queda por revisar al final del día.</span>
          </div>
        <% end %>
        <div class="flex flex-wrap items-center gap-3 border-t border-slate-200 px-4 py-3">
          <button type="button" data-action="etiquetadora#registrar" data-etiquetadora-target="btnRegistrar" class="rounded bg-emerald-700 px-4 py-3 text-lg font-semibold text-white hover:bg-emerald-600 disabled:opacity-50">Registrar e imprimir</button>
          <button type="button" data-action="etiquetadora#reimprimir" data-etiquetadora-target="btnReimprimir" class="hidden rounded border border-slate-300 px-4 py-3">Reimprimir</button>
          <button type="button" data-action="etiquetadora#limpiar" class="px-3 py-2 text-sm text-slate-500 hover:underline">Limpiar</button>
          <span class="text-sm text-emerald-800" data-etiquetadora-target="resultado"></span>
          <span class="w-full text-sm text-slate-600 empty:hidden" data-etiquetadora-target="salida"></span>
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <div class="rounded bg-white p-4 shadow-sm">
        <h2 class="mb-2 font-semibold">Pedidos por surtir</h2>
        <% if @pendientes.empty? %>
          <p class="text-sm text-slate-500">Nada pendiente.</p>
        <% else %>
          <% @pendientes.group_by(&:pedido).each do |pedido, lineas| %>
            <div class="mb-3 text-sm">
              <div class="font-semibold"><%= pedido.folio %> · <%= pedido.destino %></div>
              <% lineas.each do |l| %>
                <%= link_to new_etiqueta_path(pedido_linea_id: l.id), class: "flex justify-between gap-2 border-t border-slate-100 py-1 hover:bg-slate-50 #{'bg-blue-50' if l.id == @linea&.id}" do %>
                  <span class="truncate"><%= l.producto.nombre %></span>
                  <span class="font-mono text-slate-600">falta <%= number_with_precision(l.faltante, precision: l.producto.decimales) %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      <details class="rounded bg-white p-4 text-sm shadow-sm">
        <summary class="cursor-pointer font-semibold">Etiqueta impresa</summary>
        <div class="mt-3 grid grid-cols-2 gap-2">
          <label>Ancho (mm)<input type="number" min="20" max="200" class="mt-1 w-full rounded border border-slate-300 px-2 py-1" data-etiquetadora-target="cfgAncho" data-action="change->etiquetadora#guardarCfg"></label>
          <label>Alto (mm)<input type="number" min="15" max="200" class="mt-1 w-full rounded border border-slate-300 px-2 py-1" data-etiquetadora-target="cfgAlto" data-action="change->etiquetadora#guardarCfg"></label>
          <label class="col-span-2">Leyenda<input type="text" placeholder="ej. Select Meat" class="mt-1 w-full rounded border border-slate-300 px-2 py-1" data-etiquetadora-target="cfgLeyenda" data-action="change->etiquetadora#guardarCfg"></label>
          <label>Alto barras (px)<input type="number" min="20" max="200" class="mt-1 w-full rounded border border-slate-300 px-2 py-1" data-etiquetadora-target="cfgBarras" data-action="change->etiquetadora#guardarCfg"></label>
          <label>Letra nombre<input type="number" min="8" max="36" class="mt-1 w-full rounded border border-slate-300 px-2 py-1" data-etiquetadora-target="cfgLetra" data-action="change->etiquetadora#guardarCfg"></label>
        </div>
        <p class="mt-2 text-xs text-slate-500">Se guarda en este navegador. <button type="button" class="underline" data-action="etiquetadora#restablecerCfg">Restablecer</button></p>
      </details>
    </div>
  </div>
</div>

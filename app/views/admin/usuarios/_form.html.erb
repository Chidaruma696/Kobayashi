<%= form_with model: [ :admin, @usuario ], class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <%= render "admin/campo", f: f, campo: :nombre, etiqueta: t("comun.nombre"), tipo: :text_field %>
  <%= render "admin/campo", f: f, campo: :usuario, etiqueta: t("admin.usuario_minusculas"), tipo: :text_field, opciones: { autocapitalize: "none" } %>
  <div class="grid grid-cols-2 gap-4">
    <div><%= f.label :rol_id, t("admin.rol"), class: "block text-sm font-medium" %><%= f.collection_select :rol_id, Rol.order(:nombre), :id, :nombre, {}, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %></div>
    <div><%= f.label :sucursal_id, t("comun.sucursal"), class: "block text-sm font-medium" %><%= f.collection_select :sucursal_id, Sucursal.order(:nombre), :id, :nombre, {}, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %></div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <%= render "admin/campo", f: f, campo: :password, etiqueta: @usuario.new_record? ? t("sesion.contrasena") : t("admin.nueva_contrasena"), tipo: :password_field, opciones: { autocomplete: "new-password" } %>
  </div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :activo %> <%= t("comun.activo") %></label>
  <%= f.submit @usuario.new_record? ? t("comun.crear") : t("comun.guardar"), class: "btn btn-primary" %>
<% end %>

<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Usuarios</h1>
  <%= link_to "Nuevo usuario", new_admin_usuario_path, class: "rounded bg-slate-900 px-3 py-1 text-white" %>
</div>
<table class="w-full border-collapse bg-white text-sm shadow-sm">
  <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Nombre</th><th class="px-3 py-2">Usuario</th><th class="px-3 py-2">Rol</th><th class="px-3 py-2">Sucursal</th><th class="px-3 py-2">PIN</th><th class="px-3 py-2">Activo</th><th></th></tr></thead>
  <tbody>
    <% @usuarios.each do |u| %>
      <tr class="border-t border-slate-100 <%= 'text-slate-400' unless u.activo %>">
        <td class="px-3 py-2"><%= u.nombre %></td><td class="px-3 py-2 font-mono"><%= u.usuario %></td><td class="px-3 py-2"><%= u.rol %></td><td class="px-3 py-2"><%= u.sucursal %></td>
        <td class="px-3 py-2"><%= u.pin_digest.present? ? "sí" : "no" %></td><td class="px-3 py-2"><%= u.activo ? "sí" : "no" %></td>
        <td class="px-3 py-2 text-right"><%= link_to "editar", edit_admin_usuario_path(u), class: "text-blue-700" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= form_with model: [ :admin, @sucursal ], class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <div class="grid grid-cols-2 gap-4">
    <%= render "admin/campo", f: f, campo: :codigo, etiqueta: t("comun.codigo"), tipo: :text_field %>
    <div><%= f.label :tipo, t("salidas.tipo"), class: "block text-sm font-medium" %><%= f.select :tipo, [ [ t("comun.matriz"), "matriz" ], [ t("admin.tienda"), "tienda" ] ], {}, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %></div>
  </div>
  <%= render "admin/campo", f: f, campo: :nombre, etiqueta: t("comun.nombre"), tipo: :text_field %>
  <%= render "admin/campo", f: f, campo: :limite_efectivo, etiqueta: t("admin.limite_efectivo"), tipo: :number_field, opciones: { step: "0.01", min: 1 } %>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :activa %> <%= t("admin.activa") %></label>
  <%= f.submit @sucursal.new_record? ? t("comun.crear") : t("comun.guardar"), class: "btn btn-primary" %>
<% end %>

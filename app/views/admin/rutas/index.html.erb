<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold">Rutas</h1>
  <%= link_to "Nueva ruta", new_admin_ruta_path, class: "btn btn-primary btn-sm" %>
</div>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2">Ruta</th><th class="px-3 py-2">Chofer</th><th class="px-3 py-2">Clientes</th><th class="px-3 py-2">Activa</th><th></th></tr></thead>
  <tbody>
    <% @rutas.each do |r| %>
      <tr class="border-t border-stone-100 align-top">
        <td class="px-3 py-2 font-semibold"><%= r.nombre %></td><td class="px-3 py-2"><%= r.chofer || "—" %></td>
        <td class="px-3 py-2 text-stone-600"><%= r.clientes_en_orden.map(&:nombre).join(" → ") %></td>
        <td class="px-3 py-2"><%= r.activa ? "sí" : "no" %></td>
        <td class="px-3 py-2 text-right whitespace-nowrap"><%= link_to "Editar", edit_admin_ruta_path(r), class: "btn btn-secondary btn-xs" %> · <%= link_to "Orden de reparto", orden_admin_ruta_path(r), class: "enlace" %></td>
      </tr>
    <% end %>
    <% if @rutas.empty? %><tr><td colspan="5" class="px-3 py-6 text-center text-stone-500">Sin rutas.</td></tr><% end %>
  </tbody>
</table>

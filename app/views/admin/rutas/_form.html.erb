<%= form_with model: [ :admin, @ruta ], class: "formulario" do |f| %>
  <div class="campos">
    <%= render "admin/campo", f: f, campo: :nombre, etiqueta: t("comun.nombre"), tipo: :text_field %>
    <div><%= f.label :chofer_id, t("salidas.chofer"), class: "block text-sm font-medium" %><%= f.collection_select :chofer_id, Usuario.activos.order(:nombre), :id, :nombre, { include_blank: t("admin.sin_asignar") }, class: "entrada" %></div>
    <label class="flex items-center gap-2 self-end pb-3 text-sm"><%= f.check_box :activa %> <%= t("admin.activa") %></label>
  </div>
  <fieldset class="rounded-lg border border-stone-200 p-4">
    <legend class="px-1 text-sm font-medium"><%= t("admin.zonas_de_la_ruta") %></legend>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-stone-500"><th class="py-1"><%= t("viajes.zona") %></th><th class="w-24 py-1"><%= t("admin.orden") %></th><th class="w-20 py-1"><%= t("salidas.quitar") %></th></tr></thead>
      <tbody>
        <% zonas = @ruta.zonas.to_a.sort_by { |z| [ z.orden, z.nombre.to_s ] } + Array.new(2) { @ruta.zonas.build(orden: (@ruta.zonas.map(&:orden).max || 0) + 1) } %>
        <%= f.fields_for :zonas, zonas do |z| %>
          <tr>
            <td class="py-1 pr-2"><%= z.text_field :nombre, placeholder: t("admin.nueva_zona"), class: "w-full rounded border border-stone-300 px-2 py-1" %></td>
            <td class="py-1 pr-2"><%= z.number_field :orden, class: "w-full rounded border border-stone-300 px-2 py-1 font-mono" %></td>
            <td class="py-1"><% unless z.object.new_record? %><%= z.check_box :_destroy %><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </fieldset>
  <%= f.submit @ruta.new_record? ? t("comun.crear") : t("comun.guardar"), class: "btn btn-primary btn-lg" %>
  <% unless @ruta.new_record? %><%= link_to t("viajes.orden_de_reparto"), orden_admin_ruta_path(@ruta), class: "btn btn-secondary btn-sm ml-3" %><% end %>
<% end %>

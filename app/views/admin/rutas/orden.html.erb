<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("viajes.orden_de_reparto") %> · <%= @ruta %></h1>
  <%= link_to icono("arrow-left", t("admin.editar_ruta_y_zonas")), edit_admin_ruta_path(@ruta), class: "btn btn-ghost btn-sm" %>
</div>
<p class="mb-4 text-sm text-stone-600"><%= t("admin.orden_ayuda") %></p>
<%= form_with url: orden_admin_ruta_path(@ruta), class: "card" do |f| %>
  <table class="w-full text-sm">
    <thead class="text-left text-stone-500"><tr><th class="py-1">#</th><th class="py-1"><%= t("caja.cliente") %></th><th class="py-1"><%= t("admin.direccion") %></th><th class="w-48 py-1"><%= t("viajes.zona") %></th><th class="w-24 py-1"><%= t("admin.orden") %></th></tr></thead>
    <tbody>
      <% @clientes.each_with_index do |c, i| %>
        <tr class="border-t border-stone-100">
          <td class="py-1 font-mono"><%= i + 1 %></td>
          <td class="py-1"><%= c.nombre %></td>
          <td class="py-1 text-stone-600"><%= c.direccion %></td>
          <td class="py-1"><%= select_tag "clientes[#{c.id}][zona_id]", options_from_collection_for_select(@zonas, :id, :nombre, c.zona_id), include_blank: t("admin.sin_zona"), class: "w-full rounded border border-stone-300 px-2 py-1" %></td>
          <td class="py-1"><%= number_field_tag "clientes[#{c.id}][orden]", c.orden, min: 0, class: "w-full rounded border border-stone-300 px-2 py-1 font-mono" %></td>
        </tr>
      <% end %>
      <% if @clientes.empty? %><tr><td colspan="5" class="py-6 text-center text-stone-500"><%= t("admin.ruta_sin_clientes") %></td></tr><% end %>
    </tbody>
  </table>
  <%= f.submit t("admin.guardar_orden"), class: "btn btn-primary mt-4" %>
<% end %>

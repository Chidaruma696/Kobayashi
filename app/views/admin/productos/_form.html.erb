<%= form_with model: [ :admin, @producto ], id: "form_producto", class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <div class="grid grid-cols-2 gap-4">
    <%= render "admin/campo", f: f, campo: :clave, etiqueta: t("comun.clave"), tipo: :text_field %>
    <%= render "admin/campo", f: f, campo: :plu, etiqueta: t("admin.plu_automatico"), tipo: :number_field %>
  </div>
  <%= render "admin/campo", f: f, campo: :nombre, etiqueta: t("comun.nombre"), tipo: :text_field %>
  <%= render "admin/campo", f: f, campo: :linea, etiqueta: t("admin.linea"), tipo: :text_field %>
  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :unidad, t("comun.unidad"), class: "block text-sm font-medium" %>
      <%= f.select :unidad, Producto::UNIDADES.map { |u| [ Producto.nombre_unidad(u), u ] }, {}, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
    </div>
    <%= render "admin/campo", f: f, campo: :precio, etiqueta: t("comun.precio"), tipo: :number_field, opciones: { step: "0.01", min: 0 } %>
    <%= render "admin/campo", f: f, campo: :peso_fijo, etiqueta: t("admin.peso_por_pieza_opcional"), tipo: :number_field, opciones: { step: "0.001", min: 0 } %>
  </div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :activo %> <%= t("comun.activo") %></label>
  <%= f.submit @producto.new_record? ? t("comun.crear") : t("comun.guardar"), class: "btn btn-primary" %>
<% end %>

<%= form_with model: [ :admin, @producto ], id: "form_producto", class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <div class="grid grid-cols-2 gap-4">
    <%= render "admin/campo", f: f, campo: :clave, etiqueta: "Clave", tipo: :text_field %>
    <%= render "admin/campo", f: f, campo: :plu, etiqueta: "PLU (vacío = automático)", tipo: :number_field %>
  </div>
  <%= render "admin/campo", f: f, campo: :nombre, etiqueta: "Nombre", tipo: :text_field %>
  <%= render "admin/campo", f: f, campo: :linea, etiqueta: "Línea", tipo: :text_field %>
  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :unidad, "Unidad", class: "block text-sm font-medium" %>
      <%= f.select :unidad, [ [ "kilo", "kg" ], [ "pieza", "pieza" ] ], {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <%= render "admin/campo", f: f, campo: :precio, etiqueta: "Precio", tipo: :number_field, opciones: { step: "0.01", min: 0 } %>
    <%= render "admin/campo", f: f, campo: :peso_fijo, etiqueta: "Peso por pieza (kg, opcional)", tipo: :number_field, opciones: { step: "0.001", min: 0 } %>
  </div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :activo %> Activo</label>
  <%= f.submit @producto.new_record? ? "Crear" : "Guardar", class: "rounded bg-slate-900 px-4 py-2 font-semibold text-white" %>
<% end %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold">Productos</h1>
  <div class="flex gap-3">
    <%= form_with url: admin_productos_path, method: :get, class: "flex gap-2" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "buscar", class: "btn btn-secondary btn-sm" %>
      <%= f.submit "Buscar", class: "btn btn-secondary btn-sm" %>
    <% end %>
    <%= link_to "Nuevo producto", new_admin_producto_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2">Clave</th><th class="px-3 py-2">Nombre</th><th class="px-3 py-2">Línea</th><th class="px-3 py-2">Unidad</th><th class="px-3 py-2 text-right">Precio</th><th class="px-3 py-2">PLU</th><th class="px-3 py-2">Códigos</th><th class="px-3 py-2">Activo</th><th></th></tr></thead>
  <tbody>
    <% @productos.each do |p| %>
      <tr class="border-t border-stone-100 <%= 'text-stone-400' unless p.activo %>">
        <td class="px-3 py-2 font-mono"><%= p.clave %></td>
        <td class="px-3 py-2"><%= p.nombre %></td>
        <td class="px-3 py-2"><%= p.linea %></td>
        <td class="px-3 py-2"><%= p.unidad %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(p.precio_centavos) %></td>
        <td class="px-3 py-2 font-mono"><%= p.plu %></td>
        <td class="px-3 py-2"><%= p.codigos_barras.size %></td>
        <td class="px-3 py-2"><%= p.activo ? "sí" : "no" %></td>
        <td class="px-3 py-2 text-right"><%= link_to "Editar", edit_admin_producto_path(p), class: "btn btn-secondary btn-xs" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

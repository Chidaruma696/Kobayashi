<%= form_with model: [ :admin, @rol ], class: "max-w-4xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <%= render "admin/campo", f: f, campo: :nombre, etiqueta: "Nombre", tipo: :text_field %>
  <%= hidden_field_tag "rol[permisos][]", "" %>
  <label class="flex items-center gap-2 text-sm font-semibold"><%= check_box_tag "rol[permisos][]", "*", @rol.permisos.include?("*"), id: "permiso_todo" %> Todo (administrador)</label>
  <% Permiso::CLAVES.group_by { |clave, _| clave.split(".").first }.each do |modulo, claves| %>
    <fieldset class="rounded border border-stone-200 p-3">
      <legend class="px-1 text-sm font-semibold"><%= modulo %> <label class="ml-2 font-normal text-stone-500"><%= check_box_tag "rol[permisos][]", "#{modulo}.*", @rol.permisos.include?("#{modulo}.*"), id: "permiso_#{modulo}_todo" %> todo el módulo</label></legend>
      <div class="grid gap-1 sm:grid-cols-2">
        <% claves.each do |clave, nombre| %>
          <label class="flex items-center gap-2 text-sm"><%= check_box_tag "rol[permisos][]", clave, @rol.permisos.include?(clave), id: "permiso_#{clave.tr('.', '_')}" %> <%= nombre %> <span class="font-mono text-xs text-stone-400"><%= clave %></span></label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <%= f.submit @rol.new_record? ? "Crear" : "Guardar", class: "btn btn-primary" %>
<% end %>

<%= form_with model: [ :admin, @promocion ], class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <%= render "admin/campo", f: f, campo: :nombre, etiqueta: t("admin.nombre_en_ticket"), tipo: :text_field %>
  <div class="grid grid-cols-2 gap-4">
    <div><%= f.label :producto_id, t("comun.producto"), class: "block text-sm font-medium" %><%= f.collection_select :producto_id, Producto.activos.order(:nombre), :id, :nombre, {}, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %></div>
    <div><%= f.label :sucursal_id, t("comun.sucursal"), class: "block text-sm font-medium" %><%= f.collection_select :sucursal_id, Sucursal.activas.order(:nombre), :id, :nombre, { include_blank: t("comun.todas").downcase }, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %></div>
  </div>
  <div><%= f.label :tipo, t("admin.regla"), class: "block text-sm font-medium" %><%= f.select :tipo, Promocion::TIPOS.keys.map { |k| [ Promocion.nombre_tipo(k), k ] }, {}, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %></div>
  <div class="grid grid-cols-3 gap-4">
    <div><%= f.label :precio, t("comun.precio"), class: "block text-sm font-medium" %><%= f.number_field :precio, value: (@promocion.precio_centavos && @promocion.precio_centavos / 100.0), step: "0.01", min: 0, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %></div>
    <%= render "admin/campo", f: f, campo: :porcentaje, etiqueta: t("admin.descuento_pct"), tipo: :number_field, opciones: { step: "0.01", min: 0, max: 100 } %>
    <%= render "admin/campo", f: f, campo: :cantidad_minima, etiqueta: t("admin.cantidad_minima"), tipo: :number_field, opciones: { step: "0.001", min: 0 } %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <%= render "admin/campo", f: f, campo: :desde, etiqueta: t("admin.desde_opcional"), tipo: :date_field %>
    <%= render "admin/campo", f: f, campo: :hasta, etiqueta: t("admin.hasta_opcional"), tipo: :date_field %>
  </div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :activa %> <%= t("admin.activa") %></label>
  <p class="text-xs text-stone-500"><%= t("admin.promocion_ayuda") %></p>
  <%= f.submit @promocion.new_record? ? t("comun.crear") : t("comun.guardar"), class: "btn btn-primary" %>
<% end %>

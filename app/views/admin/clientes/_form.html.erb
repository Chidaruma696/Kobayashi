<%= form_with model: [ :admin, @cliente ], class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <%= render "admin/campo", f: f, campo: :nombre, etiqueta: "Nombre", tipo: :text_field %>
  <div class="grid grid-cols-2 gap-4">
    <%= render "admin/campo", f: f, campo: :telefono, etiqueta: "Teléfono", tipo: :text_field %>
    <div><%= f.label :ruta_id, "Ruta", class: "block text-sm font-medium" %><%= f.collection_select :ruta_id, Ruta.activas.order(:nombre), :id, :nombre, { include_blank: "sin ruta" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div>
  </div>
  <%= render "admin/campo", f: f, campo: :direccion, etiqueta: "Dirección", tipo: :text_field %>
  <div class="grid grid-cols-2 gap-4">
    <%= render "admin/campo", f: f, campo: :orden, etiqueta: "Orden en la ruta", tipo: :number_field, opciones: { min: 0 } %>
    <label class="flex items-center gap-2 self-end text-sm"><%= f.check_box :activo %> Activo</label>
  </div>
  <fieldset class="rounded border border-slate-300 p-3">
    <legend class="px-1 text-sm font-medium">Crédito de ruta</legend>
    <div class="grid gap-4 sm:grid-cols-3">
      <div><%= f.label :credito, "Tipo", class: "block text-sm font-medium" %><%= f.select :credito, Credito::TIPOS.map { |k, v| [ v, k ] }, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div>
      <div><%= f.label :limite_credito, "Límite (pesos, solo tipo límite)", class: "block text-sm font-medium" %><%= f.number_field :limite_credito, step: "0.01", min: 0, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2 font-mono" %></div>
      <div><%= f.label :dia_corte, "Día de corte (semanal / especial)", class: "block text-sm font-medium" %><%= f.select :dia_corte, Credito::DIAS.each_with_index.map { |d, i| [ d, i ] }, { include_blank: "— sin día (lunes a sábado) —" }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %></div>
    </div>
    <p class="mt-2 text-xs text-slate-500">Nota por nota: paga la anterior para sacar la nueva. Límite: bloquea al llegar al tope. Semanal: bloquea si debe algo de antes del corte. Contado abonando: crédito mientras abone cada 7 días. Especial: como semanal con su día propio; sin día, solo bloqueo manual.</p>
  </fieldset>
  <%= render "admin/campo", f: f, campo: :notas, etiqueta: "Notas", tipo: :text_area, opciones: { rows: 2 } %>
  <%= f.submit @cliente.new_record? ? "Crear" : "Guardar", class: "rounded bg-slate-900 px-4 py-2 font-semibold text-white" %>
<% end %>

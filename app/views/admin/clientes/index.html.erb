<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Clientes de ruta</h1>
  <div class="flex gap-3">
    <%= form_with url: admin_clientes_path, method: :get, class: "flex gap-2" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "buscar", class: "rounded border border-slate-300 px-3 py-1" %>
      <%= f.submit "Buscar", class: "rounded border border-slate-300 px-3 py-1" %>
    <% end %>
    <%= link_to "Nuevo cliente", new_admin_cliente_path, class: "rounded bg-slate-900 px-3 py-1 text-white" %>
  </div>
</div>
<table class="w-full border-collapse bg-white text-sm shadow-sm">
  <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Nombre</th><th class="px-3 py-2">Teléfono</th><th class="px-3 py-2">Dirección</th><th class="px-3 py-2">Ruta</th><th class="px-3 py-2">Orden</th><th class="px-3 py-2">Crédito</th><th class="px-3 py-2 text-right">Saldo</th><th class="px-3 py-2">Activo</th><th></th></tr></thead>
  <tbody>
    <% @clientes.each do |c| %>
      <tr class="border-t border-slate-100 <%= 'text-slate-400' unless c.activo %>">
        <td class="px-3 py-2"><%= c.nombre %></td><td class="px-3 py-2"><%= c.telefono %></td><td class="px-3 py-2"><%= c.direccion %></td>
        <td class="px-3 py-2"><%= c.ruta %></td><td class="px-3 py-2"><%= c.orden %></td><td class="px-3 py-2"><%= Credito::TIPOS[c.credito] %></td><td class="px-3 py-2 text-right font-mono"><%= pesos(c.saldo_centavos) %></td><td class="px-3 py-2"><%= c.activo ? "sí" : "no" %></td>
        <td class="px-3 py-2 text-right"><%= link_to "editar", edit_admin_cliente_path(c), class: "text-blue-700" %></td>
      </tr>
    <% end %>
    <% if @clientes.empty? %><tr><td colspan="9" class="px-3 py-6 text-center text-slate-500">Sin clientes.</td></tr><% end %>
  </tbody>
</table>

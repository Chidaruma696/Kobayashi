<h1 class="mb-4 text-2xl font-bold">Cargos por faltantes · <%= sucursal_actual %></h1>
<table class="w-full border-collapse bg-white text-sm shadow-sm">
  <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Fecha</th><th class="px-3 py-2">Cajero</th><th class="px-3 py-2">Conteo</th><th class="px-3 py-2 text-right">Monto</th><th class="px-3 py-2">Detalle</th><th class="px-3 py-2">Estado</th><th></th></tr></thead>
  <tbody>
    <% @cargos.each do |g| %>
      <tr class="border-t border-slate-100 align-top">
        <td class="px-3 py-2 whitespace-nowrap"><%= l g.created_at, format: :short %></td>
        <td class="px-3 py-2"><%= g.usuario %></td>
        <td class="px-3 py-2"><%= link_to g.conteo.folio, conteo_path(g.conteo), class: "font-mono text-blue-700" %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(g.monto_centavos) %></td>
        <td class="px-3 py-2 whitespace-pre-line text-slate-600"><%= g.detalle %></td>
        <td class="px-3 py-2"><%= g.estado %><%= " · #{g.resuelto_por}" if g.resuelto_por %></td>
        <td class="px-3 py-2 whitespace-nowrap">
          <% if g.estado == "pendiente" %>
            <%= button_to "Cobrado", resolver_cargo_path(g, estado: "cobrado"), class: "rounded bg-slate-900 px-2 py-1 text-white" %>
            <%= button_to "Perdonar", resolver_cargo_path(g, estado: "perdonado"), class: "mt-1 rounded border border-slate-300 px-2 py-1" %>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if @cargos.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-slate-500">Sin cargos.</td></tr><% end %>
  </tbody>
</table>

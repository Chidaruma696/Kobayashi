<h1 class="mb-4 text-2xl font-bold">Cargos · <%= sucursal_actual %></h1>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2">Fecha</th><th class="px-3 py-2">Responsable</th><th class="px-3 py-2">Origen</th><th class="px-3 py-2 text-right">Monto</th><th class="px-3 py-2">Detalle</th><th class="px-3 py-2">Estado</th><th></th></tr></thead>
  <tbody>
    <% @cargos.each do |g| %>
      <tr class="border-t border-stone-100 align-top">
        <td class="px-3 py-2 whitespace-nowrap"><%= l g.created_at, format: :short %></td>
        <td class="px-3 py-2"><%= g.usuario %></td>
        <td class="px-3 py-2"><% if g.conteo %><%= link_to g.conteo.folio, conteo_path(g.conteo), class: "chip-folio" %><% else %><%= link_to "revisión", revisiones_path, class: "enlace" %><% end %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(g.monto_centavos) %></td>
        <td class="px-3 py-2 whitespace-pre-line text-stone-600"><%= g.detalle %></td>
        <td class="px-3 py-2"><%= g.estado %><%= " · #{g.resuelto_por}" if g.resuelto_por %></td>
        <td class="px-3 py-2 whitespace-nowrap">
          <% if g.estado == "pendiente" %>
            <%= button_to "Cobrado", resolver_cargo_path(g, estado: "cobrado"), class: "btn btn-primary btn-xs" %>
            <%= button_to "Perdonar", resolver_cargo_path(g, estado: "perdonado"), class: "btn btn-secondary btn-xs mt-1" %>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if @cargos.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-stone-500">Sin cargos.</td></tr><% end %>
  </tbody>
</table>

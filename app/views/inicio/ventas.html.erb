<h1 class="mb-2 text-2xl font-bold">Ventas por producto · <%= @todas ? "todas las sucursales" : @sucursal %></h1>
<%= render "filtro" %>
<p class="mb-2 text-sm"><%= link_to icono("download", "Descargar CSV"), ventas_por_producto_path(format: :csv, desde: @desde, hasta: @hasta, sucursal_id: params[:sucursal_id]), class: "btn btn-secondary btn-sm" %></p>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2">Clave</th><th class="px-3 py-2">Producto</th><th class="px-3 py-2 text-right">Cantidad</th><th class="px-3 py-2 text-right">Importe</th><th class="px-3 py-2 text-right">Líneas</th></tr></thead>
  <tbody>
    <% @filas.each do |clave, nombre, unidad, cant, importe, n| %>
      <tr class="border-t border-stone-100"><td class="px-3 py-2 font-mono"><%= clave %></td><td class="px-3 py-2"><%= nombre %></td><td class="px-3 py-2 text-right font-mono"><%= number_with_precision(cant, precision: unidad == "kg" ? 3 : 0) %> <%= unidad %></td><td class="px-3 py-2 text-right font-mono"><%= pesos(importe) %></td><td class="px-3 py-2 text-right"><%= n %></td></tr>
    <% end %>
    <% if @filas.empty? %><tr><td colspan="5" class="px-3 py-6 text-center text-stone-500">Sin ventas en el rango.</td></tr><% end %>
  </tbody>
</table>

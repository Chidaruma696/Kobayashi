<h1 class="text-2xl font-bold">Kobayashi</h1>
<p class="mt-2 text-slate-600">Sucursal <strong><%= sucursal_actual %></strong> · <%= usuario_actual.rol %></p>
<ul class="mt-6 grid gap-3 sm:grid-cols-2">
  <% Permiso::CLAVES.each do |clave, nombre| %>
    <% next unless puede?(clave) %>
    <li class="rounded border border-slate-200 bg-white px-4 py-3 text-sm"><%= nombre %> <span class="text-slate-400">(<%= clave %>)</span></li>
  <% end %>
</ul>

<%= form_with url: url_for, method: :get, class: "mb-4 flex flex-wrap items-end gap-3 text-sm" do |f| %>
  <div><%= f.label :desde, "Desde", class: "block" %><%= f.date_field :desde, value: @desde, class: "rounded border border-slate-300 px-2 py-1" %></div>
  <div><%= f.label :hasta, "Hasta", class: "block" %><%= f.date_field :hasta, value: @hasta, class: "rounded border border-slate-300 px-2 py-1" %></div>
  <% if sucursal_actual.matriz? %>
    <div><%= f.label :sucursal_id, "Sucursal", class: "block" %><%= f.select :sucursal_id, [ [ "Todas", "todas" ] ] + Sucursal.activas.order(:nombre).pluck(:nombre, :id), { selected: (@todas ? "todas" : @sucursal.id) }, class: "rounded border border-slate-300 px-2 py-1" %></div>
  <% end %>
  <%= f.submit "Ver", class: "rounded bg-slate-900 px-3 py-1 text-white" %>
<% end %>

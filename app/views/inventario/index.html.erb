<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Existencias · <%= @sucursal %></h1>
  <%= render "selector_sucursal" %>
</div>
<table class="w-full border-collapse bg-white text-sm shadow-sm">
  <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Clave</th><th class="px-3 py-2">Producto</th><th class="px-3 py-2 text-right">Cantidad</th><th class="px-3 py-2">Unidad</th><th class="px-3 py-2"></th></tr></thead>
  <tbody>
    <% @existencias.each do |e| %>
      <tr class="border-t border-slate-100">
        <td class="px-3 py-2 font-mono"><%= e.producto.clave %></td>
        <td class="px-3 py-2"><%= e.producto.nombre %></td>
        <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(e.cantidad, precision: e.producto.decimales, delimiter: ",") %></td>
        <td class="px-3 py-2"><%= e.producto.unidad %></td>
        <td class="px-3 py-2 text-right"><%= link_to "kardex", kardex_inventario_path(producto_id: e.producto_id, sucursal_id: @sucursal.id), class: "text-blue-700 hover:underline" %></td>
      </tr>
    <% end %>
    <% if @existencias.empty? %><tr><td colspan="5" class="px-3 py-6 text-center text-slate-500">Sin existencias todavía.</td></tr><% end %>
  </tbody>
</table>

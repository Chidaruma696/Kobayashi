<h1 class="mb-4 text-2xl font-bold"><%= t("inventario.entrada_o_ajuste") %> · <%= @sucursal %></h1>
<%= form_with url: movimientos_inventario_path(sucursal_id: @sucursal.id), class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <div>
    <%= f.label :producto_id, t("comun.producto"), class: "block text-sm font-medium" %>
    <%= f.select :producto_id, Producto.activos.order(:nombre).map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, { selected: @movimiento.producto_id }, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :tipo, t("salidas.tipo"), class: "block text-sm font-medium" %>
    <%= f.select :tipo, %w[entrada ajuste_entrada ajuste_salida merma].map { |x| [ t("movimientos.#{x}"), x ] }, { selected: @movimiento.tipo }, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :cantidad, t("comun.cantidad"), class: "block text-sm font-medium" %>
    <%= f.number_field :cantidad, step: "0.001", min: "0.001", value: @movimiento.cantidad, required: true, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2 font-mono" %>
  </div>
  <div>
    <%= f.label :motivo, t("comun.motivo"), class: "block text-sm font-medium" %>
    <%= f.text_field :motivo, value: @movimiento.motivo, required: true, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
  </div>
  <% unless puede?("inventario.ajustar") %>
    <p class="text-xs text-stone-600"><%= t("inventario.queda_por_revisar") %></p>
  <% end %>
  <%= f.submit t("inventario.registrar"), class: "btn btn-primary" %>
<% end %>

<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Producción <%= @produccion.folio %> · <%= @produccion.producto.nombre %></h1>
  <span class="rounded bg-slate-200 px-3 py-1 text-sm"><%= @produccion.estado %></span>
</div>
<div class="grid gap-4 sm:grid-cols-3">
  <div class="rounded bg-white p-4 shadow-sm"><div class="text-xs uppercase text-slate-500">Entró</div><div class="font-mono text-2xl"><%= number_with_precision(@produccion.cantidad, precision: 3) %> <%= @produccion.producto.unidad %></div></div>
  <div class="rounded bg-white p-4 shadow-sm"><div class="text-xs uppercase text-slate-500">Salió</div><div class="font-mono text-2xl"><%= number_with_precision(@produccion.total_salidas, precision: 3) %></div></div>
  <div class="rounded bg-white p-4 shadow-sm"><div class="text-xs uppercase text-slate-500"><%= @produccion.abierta? ? "Disponible" : "Merma" %></div><div class="font-mono text-2xl"><%= number_with_precision(@produccion.abierta? ? @produccion.disponible : @produccion.merma, precision: 3) %></div></div>
</div>
<p class="mt-3 text-sm text-slate-600">
  <%= link_to "Pedido #{@produccion.pedido.folio}", pedido_path(@produccion.pedido), class: "text-blue-700" %>
  · abrió <%= @produccion.usuario %> el <%= l @produccion.created_at, format: :short %>
</p>
<h2 class="mb-2 mt-6 font-semibold">Salidas etiquetadas</h2>
<table class="w-full border-collapse bg-white text-sm shadow-sm">
  <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Producto</th><th class="px-3 py-2 text-right">Cantidad</th></tr></thead>
  <tbody>
    <% @salidas.each do |producto, cant| %>
      <tr class="border-t border-slate-100"><td class="px-3 py-2"><%= producto.nombre %></td><td class="px-3 py-2 text-right font-mono"><%= number_with_precision(cant, precision: producto.decimales) %> <%= producto.unidad %></td></tr>
    <% end %>
    <% if @salidas.empty? %><tr><td colspan="2" class="px-3 py-4 text-center text-slate-500">Todavía nada.</td></tr><% end %>
  </tbody>
</table>
<% if @produccion.abierta? %>
  <div class="mt-4 flex gap-3">
    <%= link_to "Etiquetar salidas", new_etiqueta_path(produccion_id: @produccion.id), class: "rounded bg-slate-900 px-4 py-2 text-white" %>
    <%= button_to "Cerrar producción", cerrar_produccion_path(@produccion), class: "rounded border border-slate-300 px-4 py-2", form: { data: { turbo_confirm: "Al cerrar, #{number_with_precision(@produccion.disponible, precision: 3)} #{@produccion.producto.unidad} quedan como merma. ¿Cerrar?" } } %>
  </div>
<% end %>

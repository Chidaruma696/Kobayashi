<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("produccion.produccion") %> <%= @produccion.folio %> · <%= @produccion.producto.nombre %></h1>
  <span class="badge"><%= t("estados.#{@produccion.estado}") %></span>
</div>
<div class="grid gap-4 sm:grid-cols-3">
  <div class="card"><div class="text-xs uppercase text-stone-500"><%= t("produccion.entro") %></div><div class="font-mono text-2xl"><%= number_with_precision(@produccion.cantidad, precision: 3) %> <%= @produccion.producto.unidad %></div></div>
  <div class="card"><div class="text-xs uppercase text-stone-500"><%= t("produccion.salio") %></div><div class="font-mono text-2xl"><%= number_with_precision(@produccion.total_salidas, precision: 3) %></div></div>
  <div class="card"><div class="text-xs uppercase text-stone-500"><%= @produccion.abierta? ? t("produccion.disponible") : t("produccion.merma") %></div><div class="font-mono text-2xl <%= 'text-red-700' if !@produccion.abierta? && @produccion.merma_excedida? %>"><%= number_with_precision(@produccion.abierta? ? @produccion.disponible : @produccion.merma, precision: 3) %><% unless @produccion.abierta? %> <span class="text-base"><%= @produccion.merma_pct %> %</span><% end %></div>
    <% if @produccion.producto.merma_esperada.present? %><div class="text-xs text-stone-500"><%= t("produccion.esperada", pct: @produccion.producto.merma_esperada.to_s("F")) %></div><% end %></div>
</div>
<% if @produccion.costo_centavos %>
  <p class="mt-3 text-sm text-stone-600"><%= t("produccion.costo_entrada") %>: <span class="font-mono"><%= pesos(@produccion.costo_centavos) %></span> · <%= t("produccion.valor_salidas") %>: <span class="font-mono"><%= pesos(@produccion.valor_salidas_centavos) %></span><% if (m = @produccion.margen_pct) %> · <%= t("produccion.margen") %>: <span class="font-mono <%= m.negative? ? 'text-red-700' : 'text-green-700' %>"><%= m %> %</span><% end %><br><span class="text-stone-500"><%= t("produccion.costo_ayuda") %></span></p>
<% elsif Modulo.activo?("compras") %>
  <p class="mt-3 text-sm text-stone-500"><%= t("produccion.sin_costo") %></p>
<% end %>
<p class="mt-3 text-sm text-stone-600">
  <%= t("produccion.abrio_el", quien: @produccion.usuario, fecha: l(@produccion.created_at, format: :short)) %>
</p>
<h2 class="mb-2 mt-6 font-semibold"><%= t("produccion.salidas_etiquetadas") %></h2>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("comun.producto") %></th><th class="px-3 py-2 text-right"><%= t("comun.cantidad") %></th>
    <% if @reparto.any? %><th class="px-3 py-2 text-right"><%= t("produccion.costo_asignado") %></th><th class="px-3 py-2 text-right"><%= t("produccion.costo_unitario") %></th><th class="px-3 py-2 text-right"><%= t("comun.precio") %></th><% end %></tr></thead>
  <tbody>
    <% @salidas.each do |producto, cant| %>
      <tr class="border-t border-stone-100"><td class="px-3 py-2"><%= producto.nombre %></td><td class="px-3 py-2 text-right font-mono"><%= number_with_precision(cant, precision: producto.decimales) %> <%= producto.unidad %></td>
        <% if (r = @reparto[producto]) %><td class="px-3 py-2 text-right font-mono"><%= pesos(r[:costo_centavos]) %></td><td class="px-3 py-2 text-right font-mono"><%= pesos(r[:costo_unitario]) %></td><td class="px-3 py-2 text-right font-mono"><%= pesos(producto.precio_centavos_en(@produccion.sucursal)) %></td><% end %></tr>
    <% end %>
    <% if @salidas.empty? %><tr><td colspan="5" class="px-3 py-4 text-center text-stone-500"><%= t("produccion.todavia_nada") %></td></tr><% end %>
  </tbody>
</table>
<% if @produccion.abierta? %>
  <div class="mt-4 flex gap-3">
    <%= link_to t("produccion.etiquetar_salidas"), new_etiqueta_path(produccion_id: @produccion.id), class: "btn btn-primary" %>
    <%= button_to t("produccion.cerrar"), cerrar_produccion_path(@produccion), class: "btn btn-secondary", form: { data: { turbo_confirm: t("produccion.confirmar_cerrar", cantidad: "#{number_with_precision(@produccion.disponible, precision: 3)} #{@produccion.producto.unidad}") } } %>
  </div>
<% end %>

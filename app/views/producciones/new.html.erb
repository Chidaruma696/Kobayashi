<h1 class="mb-4 text-2xl font-bold"><%= t("produccion.abrir") %></h1>
<%= form_with url: producciones_path, class: "formulario" do |f| %>
  <div class="campos">
    <div class="md:col-span-2">
      <%= f.label :producto_id, t("produccion.producto_que_entra"), class: "block text-sm font-medium" %>
      <%= f.select :producto_id, @productos.map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, {}, class: "entrada" %>
    </div>
    <div>
      <%= f.label :cantidad, t("produccion.cantidad_que_entra"), class: "block text-sm font-medium" %>
      <%= f.number_field :cantidad, step: "0.001", min: "0.001", required: true, class: "entrada font-mono text-xl" %>
    </div>
  </div>
  <p class="text-sm text-stone-500"><%= t("produccion.ayuda") %></p>
  <%= f.submit t("produccion.abrir"), class: "btn btn-primary btn-lg" %>
<% end %>

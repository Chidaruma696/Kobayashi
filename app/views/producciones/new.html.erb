<h1 class="mb-4 text-2xl font-bold">Abrir producción</h1>
<%= form_with url: producciones_path, class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <div>
    <%= f.label :producto_id, "Producto que entra", class: "block text-sm font-medium" %>
    <%= f.select :producto_id, @productos.map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :cantidad, "Cantidad que entra", class: "block text-sm font-medium" %>
    <%= f.number_field :cantidad, step: "0.001", min: "0.001", required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2 font-mono text-xl" %>
    <p class="mt-1 text-xs text-slate-500">Se descuenta de la existencia al abrir. Lo que sale se etiqueta bajo la producción; al cerrar, lo etiquetado entra y el resto queda como merma.</p>
  </div>
  <%= f.submit "Abrir producción", class: "rounded bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-700" %>
<% end %>

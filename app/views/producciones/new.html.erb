<h1 class="mb-4 text-2xl font-bold">Abrir producción</h1>
<%= form_with url: producciones_path, class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <% if @pedido %>
    <%= f.hidden_field :pedido_id, value: @pedido.id %>
    <p class="text-sm">Para el pedido <%= link_to @pedido.folio, pedido_path(@pedido), class: "font-mono text-blue-700" %> · <strong><%= @pedido.destino %></strong></p>
  <% elsif @pedidos.any? %>
    <div>
      <%= f.label :pedido_id, "Para el pedido", class: "block text-sm font-medium" %>
      <%= f.select :pedido_id, @pedidos.map { |p| [ "#{p.folio} · #{p.destino}", p.id ] }, {}, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-slate-500">La producción siempre se abre para un pedido: lo que sale de ella se liga a sus renglones.</p>
    </div>
  <% else %>
    <p class="rounded bg-amber-50 px-3 py-2 text-sm text-amber-800">No hay pedidos abiertos. La producción se abre para un pedido; espera a que una tienda pida.</p>
  <% end %>
  <div>
    <%= f.label :producto_id, "Producto que entra", class: "block text-sm font-medium" %>
    <%= f.select :producto_id, @productos.map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, {}, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :cantidad, "Cantidad que entra", class: "block text-sm font-medium" %>
    <%= f.number_field :cantidad, step: "0.001", min: "0.001", required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2 font-mono text-xl" %>
    <p class="mt-1 text-xs text-slate-500">Se descuenta de la existencia al abrir. Al cerrar, lo etiquetado entra y el resto queda como merma.</p>
  </div>
  <%= f.submit "Abrir producción", disabled: @pedido.nil? && @pedidos.empty?, class: "rounded bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-700 disabled:opacity-50" %>
<% end %>

<h1 class="mb-4 text-2xl font-bold"><%= t("reparto.mi_ruta") %></h1>
<% @viajes.each do |viaje, paradas| %>
  <div class="mb-6 rounded bg-white p-4 shadow-sm">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      <h2 class="font-semibold"><%= t("viajes.viaje") %> <%= viaje.folio %> · <%= viaje.ruta %> · <%= l viaje.fecha %></h2>
      <span class="text-sm text-stone-600"><%= t("salidas.chofer") %> <%= viaje.chofer %> · <%= link_to icono("printer", t("viajes.orden_de_reparto")), hoja_viaje_path(viaje), target: "_blank", class: "btn btn-secondary btn-xs" %> · <%= link_to t("viajes.viaje").downcase, viaje_path(viaje), class: "enlace" %></span>
    </div>
    <ol class="space-y-2">
      <% paradas.each do |s| %>
        <li class="flex flex-wrap items-center justify-between gap-2 rounded border border-stone-200 px-3 py-2 <%= 'bg-green-50' if s.entregada? %> <%= 'bg-red-50' if s.rechazada? %>">
          <div>
            <div class="font-semibold"><%= s.parada %>. <%= s.cliente %><%= " · #{s.cliente.zona}" if s.cliente.zona %></div>
            <div class="text-xs text-stone-600"><%= s.cliente.direccion %><%= " · #{s.cliente.telefono}" if s.cliente.telefono.present? %> · <%= t("viajes.n_bultos", count: s.salida_etiquetas.count) %><%= " · #{pesos(s.venta.saldo_centavos)}" if s.venta %></div>
          </div>
          <% if s.enviada? %>
            <%= link_to t("reparto.entregar"), reparto_parada_path(s), class: "rounded bg-emerald-700 px-4 py-2 text-lg font-semibold text-white" %>
          <% else %>
            <span class="text-sm"><%= s.entregada? ? t("reparto.entregada_y_cobrada") : t("estados.rechazada").capitalize %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
    <p class="mt-3 text-xs text-stone-500"><%= t("reparto.efectivo_que_llevas", monto: pesos(viaje.efectivo_por_entregar_centavos)) %></p>
  </div>
<% end %>
<% if @viajes.empty? %><p class="rounded bg-white p-6 text-center text-stone-500 shadow-sm"><%= t("reparto.sin_viaje") %></p><% end %>

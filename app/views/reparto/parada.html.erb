<% s = @salida %>
<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
  <h1 class="text-2xl font-bold"><%= s.cliente %></h1>
  <%= link_to "← Mi ruta", reparto_path, class: "text-sm text-blue-700 underline" %>
</div>
<p class="mb-4 text-sm text-slate-600"><%= s.cliente.direccion %><%= " · #{s.cliente.telefono}" if s.cliente.telefono.present? %> · salida <span class="font-mono"><%= s.folio %></span> · nota <span class="font-mono"><%= @venta.folio %></span> · <%= pesos(@venta.saldo_centavos) %></p>

<% pendientes = @filas.count { |f| f.estado == "pendiente" } %>
<div class="mb-4 rounded bg-white p-4 shadow-sm">
  <h2 class="mb-2 font-semibold">Entregar: escanea cada caja, tarima o paquete que bajas</h2>
  <%= form_with url: reparto_entregar_path(s), class: "flex gap-2" do |f| %>
    <%= f.text_field :codigo, autofocus: true, autocomplete: "off", placeholder: "Código del bulto", class: "flex-1 rounded border border-slate-300 px-3 py-3 font-mono text-lg" %>
    <%= f.submit "Entregar", class: "rounded bg-slate-900 px-4 py-3 text-white" %>
  <% end %>
  <p class="mt-2 text-sm">Entregados <strong><%= @filas.size - pendientes %></strong> de <%= @filas.size %> · pendientes <strong><%= pendientes %></strong></p>
  <ul class="mt-2 text-sm">
    <% @bultos.each do |bulto, hojas| %>
      <li class="flex justify-between border-t border-slate-100 py-1 <%= hojas.all? { |h| h.estado == 'recibida' } ? 'text-green-700' : (hojas.all? { |h| h.estado == 'faltante' } ? 'text-red-700' : '') %>">
        <span><span class="font-mono"><%= bulto.codigo %></span> <%= bulto.tipo %> · <%= bulto.producto.nombre %><%= " (#{hojas.size} paquetes)" if hojas.size > 1 %></span>
        <span><%= hojas.count { |h| h.estado == "recibida" } %>/<%= hojas.size %></span>
      </li>
    <% end %>
  </ul>
  <% if pendientes.positive? %>
    <details class="mt-2 text-sm"><summary class="cursor-pointer text-slate-500">Entregar todo sin escanear (queda por revisar)</summary>
      <%= form_with url: reparto_entregar_todo_path(s), class: "mt-2 flex gap-2" do |f| %>
        <%= f.text_field :motivo, placeholder: "por qué no se escaneó", required: true, class: "flex-1 rounded border border-slate-300 px-3 py-2" %>
        <%= f.submit "Dar por entregado", class: "rounded border border-amber-400 px-3 py-2" %>
      <% end %></details>
  <% end %>
</div>

<div class="mb-4 grid gap-4 md:grid-cols-2">
  <div class="rounded bg-white p-4 shadow-sm">
    <h2 class="mb-1 font-semibold">Cerrar parada y cobrar</h2>
    <p class="mb-3 text-sm text-slate-600">Lo que no escaneaste se rechaza y vuelve al camión. Cobra el resto de contado.</p>
    <%= form_with url: reparto_cerrar_path(s), class: "space-y-2 text-sm" do |f| %>
      <% if pendientes.positive? %>
        <%= f.text_field :motivo_rechazo, placeholder: "motivo del rechazo de los #{pendientes} pendientes", required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      <% end %>
      <div class="grid grid-cols-3 gap-2">
        <div><%= f.label :efectivo, "Efectivo", class: "block" %><%= f.number_field :efectivo, step: "0.01", min: 0, inputmode: "decimal", class: "w-full rounded border border-slate-300 px-2 py-2 text-right font-mono text-lg" %></div>
        <div><%= f.label :transferencia, "Transferencia", class: "block" %><%= f.number_field :transferencia, step: "0.01", min: 0, inputmode: "decimal", class: "w-full rounded border border-slate-300 px-2 py-2 text-right font-mono" %></div>
        <div><%= f.label :deposito, "Depósito", class: "block" %><%= f.number_field :deposito, step: "0.01", min: 0, inputmode: "decimal", class: "w-full rounded border border-slate-300 px-2 py-2 text-right font-mono" %></div>
      </div>
      <p class="text-xs text-slate-500">La nota vale <%= pesos(@venta.saldo_centavos) %> si se entrega todo; el sistema descuenta lo rechazado.</p>
      <%= f.submit "Cerrar parada y cobrar", class: "w-full rounded bg-emerald-700 px-4 py-3 text-lg font-semibold text-white" %>
    <% end %>
  </div>
  <div class="space-y-4">
    <div class="rounded bg-white p-4 shadow-sm">
      <h2 class="mb-1 font-semibold">No se entregó</h2>
      <%= form_with url: reparto_no_entregado_path(s), class: "flex gap-2 text-sm", data: { turbo_confirm: "Todo vuelve al camión y la nota queda en cero. ¿Seguro?" } do |f| %>
        <%= f.text_field :motivo, placeholder: "cerrado, no quiso, no estaba…", required: true, class: "flex-1 rounded border border-slate-300 px-3 py-2" %>
        <%= f.submit "No entregado", class: "rounded border border-red-400 px-3 py-2 text-red-700" %>
      <% end %>
    </div>
    <% if puede?("pedidos.solicitar") %>
      <div class="rounded bg-white p-4 shadow-sm">
        <h2 class="mb-1 font-semibold">Pedido para la próxima visita</h2>
        <%= form_with url: pedidos_path, data: { controller: "lineas" }, class: "text-sm" do |f| %>
          <%= hidden_field_tag "pedido[destino]", "cliente:#{s.cliente_id}" %>
          <%= hidden_field_tag "volver", reparto_parada_path(s) %>
          <table class="w-full">
            <tbody data-lineas-target="cuerpo">
              <% 2.times do |i| %>
                <tr data-lineas-target="fila">
                  <td class="py-1 pr-2"><%= select_tag "pedido[lineas_attributes][#{i}][producto_id]", options_from_collection_for_select(@productos, :id, ->(p) { "#{p.nombre} (#{p.unidad})" }), include_blank: "—", class: "w-full rounded border border-slate-300 px-2 py-1" %></td>
                  <td class="py-1 pr-2"><%= number_field_tag "pedido[lineas_attributes][#{i}][cantidad]", nil, step: "0.001", min: "0.001", inputmode: "decimal", class: "w-24 rounded border border-slate-300 px-2 py-1 font-mono" %></td>
                  <td class="py-1"><button type="button" data-action="lineas#quitar" class="text-red-700">✕</button></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <div class="mt-2 flex items-center gap-2">
            <button type="button" data-action="lineas#agregar" class="rounded border border-slate-300 px-3 py-1">+ renglón</button>
            <%= text_field_tag "pedido[notas]", nil, placeholder: "notas", class: "flex-1 rounded border border-slate-300 px-2 py-1" %>
            <%= submit_tag "Pedir", class: "rounded bg-slate-900 px-3 py-1 text-white" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

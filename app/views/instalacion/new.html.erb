<div class="w-full max-w-lg rounded-2xl bg-white p-8 shadow">
  <div class="mb-6 flex items-center gap-3">
    <%= image_tag "logo-b.png", alt: "Kobayashi", class: "h-12 w-12" %>
    <div>
      <h1 class="text-2xl font-bold leading-tight"><%= t("instalacion.titulo") %></h1>
      <div class="text-xs text-stone-500">Kobayashi v<%= Kobayashi::VERSION %></div>
    </div>
  </div>
  <p class="mb-4 text-sm text-stone-600"><%= t("instalacion.intro") %></p>
  <% if flash[:alert] %>
    <p class="mb-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700"><%= flash[:alert] %></p>
  <% end %>
  <%= form_with url: instalar_path, scope: :instalacion, class: "space-y-4" do |f| %>
    <fieldset class="space-y-3">
      <legend class="text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("instalacion.negocio") %></legend>
      <div>
        <%= f.label :negocio, t("instalacion.nombre_negocio"), class: "block text-sm font-medium" %>
        <%= f.text_field :negocio, value: @datos[:negocio], autofocus: true, required: true, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
        <p class="mt-1 text-xs text-stone-500"><%= t("instalacion.nombre_negocio_ayuda") %></p>
      </div>
      <div>
        <%= f.label :giro, t("instalacion.giro"), class: "block text-sm font-medium" %>
        <%= f.select :giro, Modulo::GIROS.keys.map { |g| [ t("giros.#{g}.nombre"), g ] }, { selected: @datos[:giro] }, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
        <p class="mt-1 text-xs text-stone-500"><%= t("instalacion.giro_ayuda") %></p>
        <ul class="mt-2 space-y-1 text-xs text-stone-600">
          <% Modulo::GIROS.each_key do |g| %><li><strong><%= t("giros.#{g}.nombre") %></strong>: <%= t("giros.#{g}.que") %></li><% end %>
        </ul>
      </div>
      <details class="text-sm">
        <summary class="cursor-pointer text-stone-600"><%= t("instalacion.sucursal_detalle") %></summary>
        <div class="mt-2 grid grid-cols-3 gap-3">
          <div class="col-span-2">
            <%= f.label :sucursal, t("instalacion.matriz"), class: "block text-sm font-medium" %>
            <%= f.text_field :sucursal, value: @datos[:sucursal], class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
          </div>
          <div>
            <%= f.label :codigo, t("comun.codigo"), class: "block text-sm font-medium" %>
            <%= f.text_field :codigo, value: @datos[:codigo], maxlength: 10, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2 font-mono uppercase" %>
          </div>
        </div>
        <p class="mt-1 text-xs text-stone-500"><%= t("instalacion.matriz_ayuda") %></p>
      </details>
    </fieldset>
    <fieldset class="space-y-3">
      <legend class="text-xs font-bold uppercase tracking-wide text-stone-500"><%= t("instalacion.administrador") %></legend>
      <div>
        <%= f.label :nombre, t("comun.nombre"), class: "block text-sm font-medium" %>
        <%= f.text_field :nombre, value: @datos[:nombre], required: true, autocomplete: "name", class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :usuario, t("sesion.usuario"), class: "block text-sm font-medium" %>
          <%= f.text_field :usuario, value: @datos[:usuario], required: true, autocomplete: "username", autocapitalize: "none", class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
        </div>
        <div>
          <%= f.label :password, t("sesion.contrasena"), class: "block text-sm font-medium" %>
          <%= f.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
        </div>
      </div>
      <div>
        <%= f.label :idioma, t("ajustes.idioma"), class: "block text-sm font-medium" %>
        <%= f.select :idioma, Usuario::IDIOMAS.map { |i| [ t("ajustes.idiomas.#{i}"), i ] }, { selected: @datos[:idioma] }, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
      </div>
    </fieldset>
    <%= f.submit t("instalacion.crear"), class: "btn btn-primary w-full" %>
  <% end %>
</div>

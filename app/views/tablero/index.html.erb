<h1 class="mb-2 text-2xl font-bold">Tablero · <%= @todas ? "todas las sucursales" : @sucursal %></h1>
<%= render "filtro" %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% [ [ "Ventas", pesos(@total) ], [ "Tickets", @tickets ], [ "Ticket promedio", pesos(@promedio) ], [ "Devoluciones", pesos(@devoluciones) ],
       [ "Efectivo", pesos((@por_forma["efectivo"] || 0) - @cambio) ], [ "Transferencias", pesos(@por_forma["transferencia"] || 0) ], [ "Depósitos", pesos(@por_forma["deposito"] || 0) ], [ "Inventario valorizado", pesos(@valor_existencias) ] ].each do |nombre, valor| %>
    <div class="rounded bg-white p-4 shadow-sm"><div class="text-xs uppercase text-slate-500"><%= nombre %></div><div class="font-mono text-2xl"><%= valor %></div></div>
  <% end %>
</div>
<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <div class="rounded bg-white p-4 shadow-sm">
    <h2 class="mb-2 font-semibold">Lo más vendido</h2>
    <table class="w-full text-sm">
      <% @top.each do |nombre, unidad, cant, importe| %>
        <tr class="border-t border-slate-100"><td class="py-1"><%= nombre %></td><td class="py-1 text-right font-mono"><%= number_with_precision(cant, precision: unidad == "kg" ? 3 : 0) %> <%= unidad %></td><td class="py-1 text-right font-mono"><%= pesos(importe) %></td></tr>
      <% end %>
      <% if @top.empty? %><tr><td class="py-3 text-center text-slate-500">Sin ventas en el rango.</td></tr><% end %>
    </table>
  </div>
  <div class="rounded bg-white p-4 shadow-sm">
    <h2 class="mb-2 font-semibold">Cortes cerrados</h2>
    <table class="w-full text-sm">
      <% @cortes.each do |c| %>
        <tr class="border-t border-slate-100"><td class="py-1 font-mono"><%= c.folio %></td><td class="py-1"><%= c.sucursal %> · <%= c.usuario %></td><td class="py-1 text-right font-mono"><%= pesos(c.esperado_centavos) %></td><td class="py-1 text-right font-mono <%= c.diferencia_centavos.to_i.negative? ? 'text-red-700' : 'text-green-700' %>"><%= pesos(c.diferencia_centavos) %></td></tr>
      <% end %>
      <% if @cortes.empty? %><tr><td class="py-3 text-center text-slate-500">Sin cortes en el rango.</td></tr><% end %>
    </table>
  </div>
  <div class="rounded bg-white p-4 shadow-sm">
    <h2 class="mb-2 font-semibold">Mermas de producción</h2>
    <table class="w-full text-sm">
      <% @mermas.each do |p| %>
        <tr class="border-t border-slate-100"><td class="py-1 font-mono"><%= p.folio %></td><td class="py-1"><%= p.producto.nombre %></td><td class="py-1 text-right font-mono"><%= number_with_precision(p.merma, precision: 3) %> de <%= number_with_precision(p.cantidad, precision: 3) %> (<%= p.cantidad.zero? ? 0 : (p.merma / p.cantidad * 100).round(1) %> %)</td></tr>
      <% end %>
      <% if @mermas.empty? %><tr><td class="py-3 text-center text-slate-500">Sin producciones cerradas.</td></tr><% end %>
    </table>
  </div>
  <div class="rounded bg-white p-4 shadow-sm">
    <h2 class="mb-2 font-semibold">Conteos</h2>
    <table class="w-full text-sm">
      <% @conteos.each do |c| %>
        <tr class="border-t border-slate-100"><td class="py-1 font-mono"><%= c.folio %></td><td class="py-1"><%= c.sucursal %> · <%= c.responsable %></td><td class="py-1 text-right font-mono text-red-700"><%= pesos(c.faltante_centavos) %></td><td class="py-1 text-right font-mono text-green-700"><%= pesos(c.sobrante_centavos) %></td></tr>
      <% end %>
      <% if @conteos.empty? %><tr><td class="py-3 text-center text-slate-500">Sin conteos en el rango.</td></tr><% end %>
    </table>
  </div>
</div>

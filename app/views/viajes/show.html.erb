<% v = @viaje %>
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold">Viaje <%= v.folio %> · <%= v.ruta %> · <%= l v.fecha %></h1>
  <div class="flex items-center gap-3 text-sm">
    <%= link_to icono("printer", "Orden de reparto"), hoja_viaje_path(v), target: "_blank", class: "btn btn-secondary btn-sm" %>
    <span class="rounded bg-stone-200 px-3 py-1"><%= v.estado.humanize %></span>
  </div>
</div>
<p class="mb-4 text-sm text-stone-600">Chofer <strong><%= v.chofer %></strong> · armó <%= v.usuario %><%= " · salió #{l v.salido_en, format: :short}" if v.salido_en %><%= " · #{v.notas}" if v.notas.present? %></p>

<div class="card mb-4">
  <h2 class="mb-2 font-semibold">Orden de reparto</h2>
  <table class="w-full text-sm">
    <thead class="text-left text-stone-500"><tr><th class="px-2 py-1">Parada</th><th class="px-2 py-1">Zona</th><th class="px-2 py-1">Cliente</th><th class="px-2 py-1">Salida</th><th class="px-2 py-1">Bultos</th><th class="px-2 py-1">Canastillas</th><th class="px-2 py-1 text-right">Nota</th><th class="px-2 py-1">Estado</th><th></th></tr></thead>
    <tbody>
      <% @paradas.each do |s| %>
        <tr class="border-t border-stone-100 <%= 'bg-green-50' if s.entregada? %> <%= 'bg-red-50' if s.rechazada? %>">
          <td class="px-2 py-1 font-mono"><%= s.parada %>
            <% if v.armando? %><%= button_to "↑", mover_viaje_path(v, salida_id: s.id, paso: -1), class: "btn btn-ghost btn-xs", form: { class: "inline" } %><%= button_to "↓", mover_viaje_path(v, salida_id: s.id, paso: 1), class: "btn btn-ghost btn-xs", form: { class: "inline" } %><% end %></td>
          <td class="px-2 py-1 text-stone-600"><%= s.cliente.zona %></td>
          <td class="px-2 py-1"><%= s.cliente %><span class="text-xs text-stone-500"> <%= s.cliente.direccion %></span></td>
          <td class="px-2 py-1"><%= link_to s.folio, salida_path(s), class: "chip-folio" %></td>
          <td class="px-2 py-1"><%= s.salida_etiquetas.count %></td>
          <td class="px-2 py-1 text-xs"><%= s.canastillas.includes(:tipo_canastilla).map { |c| "#{c.cantidad} #{c.tipo_canastilla}" }.join(", ") %></td>
          <td class="px-2 py-1 text-right font-mono"><% if s.venta %><%= pesos(s.venta.saldo_centavos) %><span class="text-xs text-stone-500"> <%= s.venta.estado.humanize.downcase %></span><% end %></td>
          <td class="px-2 py-1"><%= s.estado %></td>
          <td class="px-2 py-1 text-right">
            <% if v.armando? %><%= button_to "Quitar", quitar_viaje_path(v, salida_id: s.id), class: "btn btn-ghost-danger btn-xs" %><% end %>
            <% if v.en_ruta? && s.enviada? && puede?("rutas.repartir") %><%= link_to "Parada", reparto_parada_path(s), class: "btn btn-primary btn-xs" %><% end %>
          </td>
        </tr>
      <% end %>
      <% if @paradas.empty? %><tr><td colspan="9" class="py-3 text-center text-stone-500">Sin repartos todavía.</td></tr><% end %>
    </tbody>
  </table>
</div>

<% if v.armando? && puede?("rutas.armar") %>
  <div class="mb-4 grid gap-4 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold">Repartos que se pueden subir</h2>
      <% if @candidatas.any? %>
        <ul class="text-sm">
          <% @candidatas.each do |s| %>
            <li class="flex items-center justify-between border-t border-stone-100 py-1">
              <span><span class="font-mono"><%= s.folio %></span> · <%= s.cliente %><%= " · #{s.ruta}" if s.ruta %> · <%= s.estado %></span>
              <%= button_to "Subir", agregar_viaje_path(v, salida_id: s.id), class: "btn btn-secondary btn-xs" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-stone-500">No hay repartos abiertos sin viaje. <%= link_to "Nueva salida a un cliente", new_salida_path, class: "btn btn-primary btn-xs" %>.</p>
      <% end %>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold">Despachar</h2>
      <p class="mb-3 text-sm text-stone-600">Todas las paradas deben estar selladas. Al salir, cada reparto cierra su nota por cobrar y baja el inventario. Hace falta caja abierta en <%= v.sucursal %>.</p>
      <%= button_to "Sale el camión", salir_viaje_path(v), class: "btn btn-success", form: { data: { turbo_confirm: "¿Despachar el viaje #{v.folio} con #{@paradas.size} paradas?" } } %>
      <%= button_to "Cancelar viaje", cancelar_viaje_path(v), class: "btn btn-ghost-danger btn-sm mt-4", form: { data: { turbo_confirm: "¿Cancelar el viaje?" } } %>
    </div>
  </div>
<% end %>

<% if v.en_ruta? || v.liquidado? %>
  <% cobrado = v.cobrado_centavos %>
  <div class="mb-4 grid gap-4 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold">Dinero del viaje</h2>
      <table class="w-full text-sm">
        <tr><td class="px-2 py-1">Cobrado en efectivo (notas y abonos)</td><td class="px-2 py-1 text-right font-mono"><%= pesos(cobrado["efectivo"] || 0) %></td></tr>
        <tr><td class="px-2 py-1">Cambio dado</td><td class="px-2 py-1 text-right font-mono">−<%= pesos(v.cambio_centavos) %></td></tr>
        <tr><td class="px-2 py-1">A crédito (a la cuenta del cliente)</td><td class="px-2 py-1 text-right font-mono text-stone-500"><%= pesos(v.credito_centavos) %></td></tr>
        <tr><td class="px-2 py-1">Transferencias y depósitos</td><td class="px-2 py-1 text-right font-mono"><%= pesos((cobrado["transferencia"] || 0) + (cobrado["deposito"] || 0)) %></td></tr>
        <tr><td class="px-2 py-1">Gastos del chofer</td><td class="px-2 py-1 text-right font-mono">−<%= pesos(v.gastos_centavos) %></td></tr>
        <tr class="border-t border-stone-300 font-semibold"><td class="px-2 py-1">Efectivo que debe entregar</td><td class="px-2 py-1 text-right font-mono"><%= pesos(v.liquidado? ? v.efectivo_esperado_centavos : v.efectivo_por_entregar_centavos) %></td></tr>
        <% if v.liquidado? %>
          <tr><td class="px-2 py-1">Entregó</td><td class="px-2 py-1 text-right font-mono"><%= pesos(v.efectivo_entregado_centavos) %></td></tr>
          <tr class="font-semibold <%= v.diferencia_centavos.negative? ? 'text-red-700' : 'text-green-700' %>"><td class="px-2 py-1">Diferencia</td><td class="px-2 py-1 text-right font-mono"><%= pesos(v.diferencia_centavos) %></td></tr>
        <% end %>
      </table>
      <% if v.gastos.any? %>
        <ul class="mt-3 text-xs text-stone-600">
          <% v.gastos.each do |g| %><li><%= g.concepto %> · <%= pesos(g.monto_centavos) %> (<%= g.usuario %>)</li><% end %>
        </ul>
      <% end %>
      <% if @tipos.any? %>
        <h3 class="mt-4 text-sm font-semibold">Canastillas</h3>
        <table class="w-full text-sm">
          <% cargadas = v.canastillas_cargadas; a_bordo = v.canastillas_a_bordo %>
          <% @tipos.each do |t| %>
            <tr><td class="px-2 py-1"><%= t %></td><td class="px-2 py-1 text-right font-mono">cargadas <%= cargadas[t.id] || 0 %></td><td class="px-2 py-1 text-right font-mono"><%= v.liquidado? ? "quedan en camión #{a_bordo[t.id] || 0}" : "a bordo #{a_bordo[t.id] || 0}" %></td></tr>
          <% end %>
        </table>
      <% end %>
      <% unless v.liquidado? %>
        <%= form_with url: gasto_viaje_path(v), class: "mt-3 flex flex-wrap gap-2 text-sm" do |f| %>
          <%= f.text_field :concepto, placeholder: "gasto (gasolina, caseta…)", required: true, class: "flex-1 rounded border border-stone-300 px-2 py-1" %>
          <%= f.number_field :monto, step: "0.01", min: "0.01", placeholder: "monto", required: true, class: "w-28 rounded border border-stone-300 px-2 py-1 font-mono" %>
          <%= f.submit "Agregar gasto", class: "btn btn-secondary btn-sm" %>
        <% end %>
      <% end %>
    </div>
    <% if v.en_ruta? && puede?("rutas.liquidar") %>
      <div class="card">
        <h2 class="mb-2 font-semibold">Liquidar el viaje</h2>
        <p class="mb-3 text-sm text-stone-600">Cuenta el efectivo que trae el chofer. Las paradas que sigan abiertas se dan por no entregadas y su mercancía vuelve. Lo cobrado entra a la caja abierta; si falta dinero se le carga al chofer.</p>
        <%= form_with url: liquidar_viaje_path(v), class: "flex flex-wrap items-end gap-3 text-sm", data: { turbo_confirm: "¿Liquidar el viaje #{v.folio}?" } do |f| %>
          <div><%= f.label :entregado, "Efectivo entregado", class: "block" %><%= f.number_field :entregado, step: "0.01", min: "0", value: v.efectivo_por_entregar_centavos / 100.0, required: true, class: "w-40 rounded border border-stone-300 px-2 py-2 text-right font-mono text-xl" %></div>
          <% v.canastillas_a_bordo.each do |tipo_id, n| %>
            <div><%= label_tag "canastillas_#{tipo_id}", "#{TipoCanastilla.find(tipo_id)} que regresan", class: "block" %><%= number_field_tag "canastillas[#{tipo_id}]", n, min: 0, id: "canastillas_#{tipo_id}", class: "w-32 rounded border border-stone-300 px-2 py-2 text-right font-mono" %></div>
          <% end %>
          <%= f.submit "Liquidar", class: "btn btn-success" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

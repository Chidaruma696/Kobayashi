<div class="ticket">
  <div class="centro"><strong><%= t("viajes.orden_de_reparto").upcase %> <%= @viaje.folio %></strong></div>
  <div class="centro"><%= @viaje.ruta %> · <%= l @viaje.fecha %></div>
  <div class="centro"><%= t("salidas.chofer") %>: <%= @viaje.chofer %></div>
  <div class="linea"></div>
  <% @paradas.each do |s| %>
    <div><strong><%= s.parada %>. <%= s.cliente %></strong> <%= s.folio %><%= " · #{s.cliente.zona}" if s.cliente.zona %></div>
    <% if s.cliente.direccion.present? %><div><%= s.cliente.direccion %></div><% end %>
    <% if s.cliente.telefono.present? %><div><%= t("viajes.tel") %> <%= s.cliente.telefono %></div><% end %>
    <table>
      <% s.contenido.each do |producto, cant| %>
        <tr><td><%= producto.nombre %></td><td class="der"><%= number_with_precision(cant, precision: producto.decimales) %> <%= producto.unidad %></td></tr>
      <% end %>
    </table>
    <% if (saldo = s.cliente.saldo_centavos).positive? %><div><%= t("viajes.debe") %>: <%= Dinero.pesos(saldo) %> · <%= Credito.nombre(s.cliente.credito) %></div><% end %>
    <% if s.canastillas.any? %><div><%= t("viajes.canastillas") %>: <%= s.canastillas.includes(:tipo_canastilla).map { |c| "#{c.cantidad} #{c.tipo_canastilla}" }.join(", ") %><% saldo_c = s.cliente.saldo_canastillas %><%= " · #{t("viajes.debe").downcase} #{saldo_c.map { |t, n| "#{n} #{TipoCanastilla.find(t)}" }.join(', ')}" if saldo_c.any? %></div><% end %>
    <div class="der"><%= t("viajes.n_bultos", count: s.salida_etiquetas.count) %><%= " · #{t("viajes.nota").downcase} #{s.venta.folio} #{Dinero.pesos(s.venta.saldo_centavos)}" if s.venta %></div>
    <div><%= t("viajes.cobrado") %>: ____________  <%= t("viajes.firma") %>: ____________</div>
    <div class="linea"></div>
  <% end %>
  <div><%= t("viajes.total_paradas") %>: <%= @paradas.size %></div>
  <% if @viaje.ventas.any? %><div class="total"><%= t("viajes.a_cobrar") %>: <%= Dinero.pesos(@viaje.ventas.sum(:total_centavos)) %></div><% end %>
</div>

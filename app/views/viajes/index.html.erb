<h1 class="mb-4 text-2xl font-bold"><%= t("viajes.viajes_de_reparto") %> · <%= sucursal_actual %></h1>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("comun.folio") %></th><th class="px-3 py-2"><%= t("comun.fecha") %></th><th class="px-3 py-2"><%= t("salidas.ruta") %></th><th class="px-3 py-2"><%= t("salidas.chofer") %></th><th class="px-3 py-2"><%= t("comun.estado") %></th><th class="px-3 py-2"><%= t("viajes.paradas") %></th><th></th></tr></thead>
  <tbody>
    <% @abiertos.each do |v| %>
      <% cerradas = v.salidas.count { |s| s.entregada? || s.rechazada? } %>
      <tr class="border-t border-stone-100">
        <td class="px-3 py-2 font-mono"><%= v.folio %></td>
        <td class="px-3 py-2"><%= l v.fecha %></td>
        <td class="px-3 py-2"><%= v.ruta %></td>
        <td class="px-3 py-2"><%= v.chofer %></td>
        <td class="px-3 py-2"><%= t("estados.#{v.estado}").capitalize %></td>
        <td class="px-3 py-2"><%= v.en_ruta? ? "#{cerradas}/#{v.salidas.size} #{t("viajes.cerradas")}" : "#{v.salidas.size}" %></td>
        <td class="px-3 py-2 text-right"><%= link_to v.en_ruta? ? t("viajes.liquidar") : t("viajes.armar"), viaje_path(v), class: "btn btn-primary btn-sm" %></td>
      </tr>
    <% end %>
    <% if @abiertos.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-stone-500"><%= t("viajes.ninguno_abierto") %></td></tr><% end %>
  </tbody>
</table>
<% if @liquidados.any? %>
  <h2 class="mb-2 mt-8 font-semibold"><%= t("viajes.liquidados") %></h2>
  <table class="tabla">
    <tbody>
      <% @liquidados.each do |v| %>
        <tr class="border-t border-stone-100">
          <td class="px-3 py-1"><%= link_to v.folio, viaje_path(v), class: "chip-folio" %></td>
          <td class="px-3 py-1"><%= l v.fecha %> · <%= v.ruta %> · <%= v.chofer %></td>
          <td class="px-3 py-1"><%= t("estados.#{v.estado}") %><%= " #{t("viajes.por")} #{v.liquidado_por}" if v.liquidado_por %></td>
          <td class="px-3 py-1 text-right font-mono"><%= pesos(v.efectivo_entregado_centavos) if v.liquidado? %></td>
          <td class="px-3 py-1 text-right font-mono <%= v.diferencia_centavos.to_i.negative? ? 'text-red-700' : 'text-green-700' %>"><%= pesos(v.diferencia_centavos) if v.liquidado? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h1 class="mb-4 text-2xl font-bold">Por recibir · <%= sucursal_actual %></h1>
<table class="w-full border-collapse bg-white text-sm shadow-sm">
  <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Folio</th><th class="px-3 py-2">Desde</th><th class="px-3 py-2">Enviada</th><th class="px-3 py-2">Paquetes</th><th></th></tr></thead>
  <tbody>
    <% @salidas.each do |s| %>
      <tr class="border-t border-slate-100">
        <td class="px-3 py-2 font-mono"><%= s.folio %></td>
        <td class="px-3 py-2"><%= s.sucursal_origen %></td>
        <td class="px-3 py-2"><%= l s.enviado_en, format: :short %></td>
        <td class="px-3 py-2"><%= s.salida_etiquetas.where(estado: "recibida").count %>/<%= s.salida_etiquetas.count %></td>
        <td class="px-3 py-2 text-right"><%= link_to "Recibir", salida_path(s), class: "rounded bg-slate-900 px-3 py-1 text-white" %></td>
      </tr>
    <% end %>
    <% if @salidas.empty? %><tr><td colspan="5" class="px-3 py-6 text-center text-slate-500">No hay nada en camino.</td></tr><% end %>
  </tbody>
</table>
<% if @recibidas.any? %>
  <h2 class="mb-2 mt-8 font-semibold">Recibidas</h2>
  <ul class="text-sm"><% @recibidas.each do |s| %><li class="border-t border-slate-200 py-1"><%= link_to s.folio, salida_path(s), class: "font-mono text-blue-700" %> · desde <%= s.sucursal_origen %> · <%= l s.recibido_en, format: :short %></li><% end %></ul>
<% end %>

<h1 class="mb-4 text-2xl font-bold"><%= t("salidas.nueva_desde", sucursal: sucursal_actual) %></h1>
<%= form_with url: salidas_path, class: "max-w-3xl space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <% if @pedido %>
    <%= f.hidden_field :pedido_id, value: @pedido.id %>
    <p class="text-sm"><%= t("pedidos.para") %> <strong><%= @pedido.destino %></strong> · <%= t("salidas.surte_el_pedido") %> <%= link_to @pedido.folio, pedido_path(@pedido), class: "chip-folio" %></p>
  <% else %>
    <div>
      <%= f.label :destino, t("pedidos.para"), class: "block text-sm font-medium" %>
      <%= f.select :destino, grouped_options_for_select({ t("salidas.tiendas") => @destinos.map { |s| [ s.nombre, "sucursal:#{s.id}" ] }, t("salidas.clientes_de_ruta") => @clientes.map { |c| [ "#{c.nombre}#{" · #{c.ruta}" if c.ruta}", "cliente:#{c.id}" ] } }), {}, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
    </div>
  <% end %>
  <% unless sucursal_actual.matriz? %>
    <div>
      <%= f.label :motivo, t("salidas.motivo_devolucion"), class: "block text-sm font-medium" %>
      <%= f.text_field :motivo, required: true, class: "mt-1 w-full rounded border border-stone-300 px-3 py-2" %>
    </div>
  <% end %>
  <%= f.submit t("salidas.abrir_salida"), class: "btn btn-primary" %>
<% end %>

<h1 class="mb-4 text-2xl font-bold">Nueva salida desde <%= sucursal_actual %></h1>
<%= form_with url: salidas_path, class: "max-w-lg space-y-4 rounded bg-white p-6 shadow-sm" do |f| %>
  <div>
    <%= f.label :sucursal_destino_id, "Para", class: "block text-sm font-medium" %>
    <%= f.collection_select :sucursal_destino_id, @destinos, :id, :nombre, { selected: @pedido&.sucursal_destino_id }, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <% unless sucursal_actual.matriz? %>
    <div>
      <%= f.label :motivo, "Motivo de la devolución", class: "block text-sm font-medium" %>
      <%= f.text_field :motivo, required: true, class: "mt-1 w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
  <% end %>
  <%= f.submit "Abrir salida", class: "rounded bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-700" %>
<% end %>

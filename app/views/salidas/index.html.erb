<h1 class="mb-4 text-2xl font-bold"><%= t("salidas.en_curso") %> · <%= sucursal_actual %></h1>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("comun.folio") %></th><th class="px-3 py-2"><%= t("salidas.tipo") %></th><th class="px-3 py-2"><%= t("pedidos.para") %></th><th class="px-3 py-2"><%= t("comun.estado") %></th><th class="px-3 py-2"><%= t("salidas.paquetes") %></th><th class="px-3 py-2"><%= t("salidas.abrio") %></th><th></th></tr></thead>
  <tbody>
    <% @salidas.each do |s| %>
      <tr class="border-t border-stone-100">
        <td class="px-3 py-2 font-mono"><%= s.folio %></td>
        <td class="px-3 py-2"><%= t("salidas.tipos.#{s.tipo}") %></td>
        <td class="px-3 py-2"><%= s.destino %></td>
        <td class="px-3 py-2"><%= t("estados.#{s.estado}") %></td>
        <td class="px-3 py-2"><%= s.salida_etiquetas.count %></td>
        <td class="px-3 py-2"><%= s.usuario %> · <%= l s.created_at, format: :short %></td>
        <td class="px-3 py-2 text-right"><%= link_to t("comun.abrir"), salida_path(s), class: "btn btn-primary btn-sm" %></td>
      </tr>
    <% end %>
    <% if @salidas.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-stone-500"><%= t("salidas.nada_en_curso") %></td></tr><% end %>
  </tbody>
</table>
<% if @historial.any? %>
  <h2 class="mb-2 mt-8 font-semibold"><%= t("salidas.historial") %></h2>
  <ul class="text-sm"><% @historial.each do |s| %><li class="border-t border-stone-200 py-1"><%= link_to s.folio, salida_path(s), class: "chip-folio" %> · <%= s.destino %> · <%= t("estados.#{s.estado}") %> · <%= l s.created_at.to_date, format: :short %></li><% end %></ul>
<% end %>

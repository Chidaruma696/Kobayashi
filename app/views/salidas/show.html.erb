<% s = @salida %>
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("salidas.titulos.#{s.tipo}") %> <%= s.folio %> · <%= s.sucursal_origen %> → <%= s.destino %><%= " (#{t("salidas.ruta").downcase} #{s.ruta})" if s.ruta %></h1>
  <span class="badge"><%= t("estados.#{s.estado}") %></span>
</div>
<p class="mb-4 text-sm text-stone-600"><%= t("salidas.abrio_el", quien: s.usuario, fecha: l(s.created_at, format: :short)) %><%= " · #{t("salidas.verifico")} #{s.verificado_por}" if s.verificado_por %><%= " · #{s.motivo}" if s.motivo.present? %></p>

<% if s.preparando? && s.sucursal_origen_id == sucursal_actual.id %>
  <div class="mb-4 grid gap-4 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("salidas.surtir_escanea") %></h2>
      <%= render "escaneo", url: agregar_salida_path(s), placeholder: t("salidas.codigo_etiqueta"), boton: t("salidas.agregar") %>
      <details class="mt-2 text-sm"><summary class="cursor-pointer text-stone-500"><%= t("salidas.quitar_etiqueta") %></summary>
        <%= render "escaneo", url: quitar_salida_path(s), placeholder: t("salidas.codigo_etiqueta"), boton: t("salidas.quitar") %></details>
      <% if s.reparto? && Modulo.activo?("retornables") && (tipos = TipoCanastilla.activos.to_a).any? %>
        <div class="mt-3 text-sm">
          <span class="font-semibold"><%= t("salidas.canastillas_que_van") %></span> <%= s.canastillas.includes(:tipo_canastilla).map { |c| "#{c.cantidad} #{c.tipo_canastilla}" }.join(", ").presence || t("salidas.ninguna") %>
          <%= form_with url: canastillas_salida_path(s), class: "mt-1 flex gap-2" do |f| %>
            <%= f.select :tipo_canastilla_id, tipos.map { |t| [ t.to_s, t.id ] }, {}, class: "btn btn-secondary btn-xs" %>
            <%= f.number_field :cantidad, min: 0, placeholder: t("salidas.cantidad_cero_quita"), required: true, class: "w-32 rounded border border-stone-300 px-2 py-1 font-mono" %>
            <%= f.submit t("salidas.anotar"), class: "btn btn-secondary btn-sm" %>
          <% end %>
        </div>
      <% end %>
      <details class="mt-2 text-sm"><summary class="cursor-pointer text-stone-500"><%= t("salidas.renglon_sin_etiqueta") %></summary>
          <%= form_with url: manual_salida_path(s), class: "mt-2 grid grid-cols-2 gap-2" do |f| %>
            <%= f.select :producto_id, Producto.activos.order(:nombre).map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, {}, class: "col-span-2 rounded border border-stone-300 px-2 py-1" %>
            <%= f.number_field :cantidad, step: "0.001", min: "0.001", placeholder: t("comun.cantidad").downcase, required: true, class: "rounded border border-stone-300 px-2 py-1 font-mono" %>
            <%= f.text_field :motivo, placeholder: t("salidas.motivo_sin_etiqueta"), required: true, class: "col-span-2 rounded border border-stone-300 px-2 py-1" %>
            <%= f.submit t("salidas.agregar_renglon"), class: "btn btn-primary btn-sm col-span-2" %>
          <% end %></details>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("salidas.verificar_carga") %></h2>
      <% if puede?("salidas.verificar") %>
        <%= render "escaneo", url: verificar_salida_path(s), placeholder: t("salidas.escanea_sube_camion"), boton: t("salidas.verificar") %>
        <p class="mt-2 text-sm text-stone-600"><%= t("salidas.sin_verificar_n", n: s.sin_verificar.count, total: s.salida_etiquetas.count) %></p>
        <%= button_to t("salidas.sellar"), sellar_salida_path(s), class: "mt-2 rounded bg-emerald-700 px-3 py-2 text-white", disabled: s.sin_verificar.exists? || s.salida_etiquetas.none? && s.lineas.none? %>
      <% else %>
        <p class="text-sm text-stone-500"><%= t("salidas.necesita_permiso_verificar") %></p>
      <% end %>
      <% if s.sin_verificar.exists? || s.salida_etiquetas.none? %>
        <details class="mt-3 text-sm"><summary class="cursor-pointer text-stone-500"><%= t("salidas.sellar_sin_verificar") %></summary>
          <%= form_with url: sellar_salida_path(s), class: "mt-2 flex gap-2" do |f| %>
            <%= f.text_field :motivo_sin_verificar, placeholder: t("salidas.por_que_sin_segundo_escaneo"), required: true, class: "flex-1 rounded border border-stone-300 px-3 py-2" %>
            <%= f.submit t("salidas.sellar_asi"), class: "btn btn-warning" %>
          <% end %></details>
      <% end %>
    </div>
  </div>
<% end %>

<% if s.sellada? && s.sucursal_origen_id == sucursal_actual.id %>
  <div class="mb-4 flex items-center gap-3 rounded border-l-4 border-emerald-600 bg-emerald-50 p-3 text-sm">
    <%= t("salidas.sellada_por", quien: s.verificado_por) %> <%= s.reparto? ? t("salidas.al_enviar_reparto") : t("salidas.al_enviar_baja", sucursal: s.sucursal_origen) %>
    <%= button_to t("salidas.enviar"), enviar_salida_path(s), class: "btn btn-success", form: { data: { turbo_confirm: t("salidas.confirmar_enviar", folio: s.folio) } } %>
  </div>
<% end %>

<% if s.reparto? && s.viaje %>
  <p class="mb-4 rounded bg-stone-100 p-3 text-sm"><%= t("salidas.va_en_viaje") %> <%= link_to s.viaje.folio, viaje_path(s.viaje), class: "chip-folio" %> (<%= s.viaje.ruta %>, <%= t("salidas.chofer").downcase %> <%= s.viaje.chofer %>). <%= s.enviada? ? t("salidas.se_cobra_en_parada") : "" %></p>
<% elsif s.reparto? && s.abierta? && puede?("rutas.armar") %>
  <% viajes = Viaje.where(sucursal: s.sucursal_origen, estado: "armando").includes(:ruta, :chofer).order(:fecha) %>
  <div class="mb-4 flex flex-wrap items-center gap-3 rounded bg-stone-100 p-3 text-sm">
    <% if viajes.any? %>
      <%= form_with url: subir_viajes_path, class: "flex flex-wrap items-center gap-2" do |f| %>
        <label><%= t("salidas.subir_al_viaje") %></label>
        <%= f.select :viaje_id, viajes.map { |v| [ "#{v.folio} · #{v.ruta} · #{v.chofer} · #{l v.fecha}", v.id ] }, { selected: viajes.find { |v| v.ruta_id == s.ruta_id }&.id }, class: "btn btn-secondary btn-xs" %>
        <%= f.hidden_field :salida_id, value: s.id %>
        <%= f.submit t("salidas.agregar"), class: "btn btn-primary btn-sm" %>
      <% end %>
    <% else %>
      <%= t("salidas.sin_viaje_armandose") %> <%= link_to t("salidas.armar_viaje_de", ruta: s.ruta || t("salidas.tipos.reparto").downcase), new_viaje_path(ruta_id: s.ruta_id), class: "btn btn-primary btn-xs" %>
    <% end %>
  </div>
<% end %>
<% if s.reparto? && s.enviada? && s.viaje.nil? && s.sucursal_origen_id == sucursal_actual.id && puede?("caja.vender") %>
  <div class="card mb-4">
    <h2 class="mb-1 font-semibold"><%= t("salidas.cobrar_entrega_nota") %> <%= link_to s.venta.folio, caja_ticket_path(s.venta), target: "_blank", class: "chip-folio" %> · <%= pesos(s.venta.total_centavos) %></h2>
    <p class="mb-2 text-sm text-stone-600"><%= t("salidas.cobrar_entrega_ayuda") %></p>
    <%= form_with url: cobrar_entrega_salida_path(s), class: "flex flex-wrap items-end gap-3 text-sm" do |f| %>
      <div><%= f.label :efectivo, t("formas_pago.efectivo"), class: "block" %><%= f.number_field :efectivo, step: "0.01", min: 0, value: s.venta.total_centavos / 100.0, class: "w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono" %></div>
      <div><%= f.label :transferencia, t("formas_pago.transferencia"), class: "block" %><%= f.number_field :transferencia, step: "0.01", min: 0, class: "w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono" %></div>
      <div><%= f.label :deposito, t("formas_pago.deposito"), class: "block" %><%= f.number_field :deposito, step: "0.01", min: 0, class: "w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono" %></div>
      <%= f.submit t("salidas.cobrar_entrega"), class: "btn btn-success" %>
    <% end %>
  </div>
<% end %>
<% if s.entregada? && s.venta %>
  <p class="mb-4 rounded bg-green-50 p-3 text-sm"><%= t("salidas.entregada_y_cobrada") %> <%= link_to s.venta.folio, caja_ticket_path(s.venta), target: "_blank", class: "chip-folio" %> · <%= pesos(s.venta.saldo_centavos) %><%= " (#{t("salidas.rechazo")} #{pesos(s.venta.total_devuelto_centavos)})" if s.venta.total_devuelto_centavos.positive? %></p>
<% elsif s.rechazada? && s.venta %>
  <p class="mb-4 rounded bg-red-50 p-3 text-sm"><%= t("salidas.rechazada_completa", folio: s.venta.folio) %></p>
<% end %>

<% if @recibiendo %>
  <div class="mb-4 grid gap-4 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("salidas.recibir_paquete_o_tarima") %></h2>
      <%= render "escaneo", url: recibir_etiqueta_salida_path(s), placeholder: t("salidas.codigo_paquete_o_tarima"), boton: t("salidas.recibir") %>
      <% sin_precio = s.contenido.keys.select { |p| p.precio_centavos_en(sucursal_actual).zero? } %>
      <% if sin_precio.any? %>
        <p class="mt-2 rounded bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= t("salidas.llegan_sin_precio_html", productos: sin_precio.map(&:nombre).join(", ")) %></p>
      <% end %>
      <details class="mt-2 text-sm"><summary class="cursor-pointer text-stone-500"><%= t("salidas.sobrante_titulo") %></summary>
        <p class="mt-1 text-xs text-stone-500"><%= t("salidas.sobrante_ayuda") %></p>
        <%= render "escaneo", url: sobrante_salida_path(s), placeholder: t("salidas.codigo_paquete"), boton: t("salidas.recibir_sobrante"), motivo: true %>
      </details>
      <p class="mt-2 text-sm text-stone-600"><%= t("salidas.conteo_recepcion", recibidos: @filas.count { |f| f.estado == "recibida" }, faltantes: @filas.count { |f| f.estado == "faltante" }, pendientes: @filas.count { |f| f.estado == "pendiente" }) %></p>
    </div>
    <div class="card md:col-span-2">
      <h2 class="mb-2 font-semibold"><%= t("salidas.canto_titulo") %></h2>
      <table class="w-full text-sm">
        <thead class="text-left text-stone-500"><tr><th class="py-1"><%= t("salidas.grupo") %></th><th class="py-1"><%= t("comun.producto") %></th><th class="py-1 text-right"><%= t("salidas.dice") %></th><th class="py-1 text-right"><%= t("salidas.llego") %></th><th class="py-1 text-right"><%= t("salidas.falta") %></th><th class="py-1"><%= t("salidas.codigos_faltan") %></th></tr></thead>
        <tbody>
          <% s.resumen_por_caja.each do |c| %>
            <tr class="border-t border-stone-100 <%= c.completo? ? 'text-green-800' : 'bg-red-50' %>">
              <td class="py-1 font-mono text-xs"><%= c.grupo ? "#{t("etiquetas.tipos.#{c.grupo.tipo}")} #{c.grupo.codigo}" : t("salidas.suelto") %></td>
              <td class="py-1"><%= c.producto&.nombre %></td>
              <td class="py-1 text-right font-mono"><%= c.producto ? cantidad(c.esperado, c.producto) : c.esperado %> · <%= t("etiquetas.n_paquetes", count: c.paquetes) %></td>
              <td class="py-1 text-right font-mono"><%= c.producto ? cantidad(c.recibido, c.producto) : c.recibido %> · <%= c.recibidos %></td>
              <td class="py-1 text-right font-mono font-semibold"><%= c.completo? ? "—" : (c.producto ? cantidad(c.diferencia, c.producto) : c.diferencia) %></td>
              <td class="py-1 font-mono text-xs"><%= c.faltan.join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("salidas.reportar_roto") %></h2>
      <%= render "escaneo", url: reportar_salida_path(s), placeholder: t("salidas.codigo_paquete"), boton: t("salidas.reportar"), motivo: true %>
      <h2 class="mb-2 mt-4 font-semibold"><%= t("salidas.cerrar_recepcion") %></h2>
      <%= form_with url: cerrar_recepcion_salida_path(s), class: "flex gap-2 text-sm", data: { turbo_confirm: t("salidas.confirmar_cerrar_recepcion") } do |f| %>
        <%= f.text_field :motivo, placeholder: t("salidas.motivo_pendiente"), class: "flex-1 rounded border border-stone-300 px-3 py-2" %>
        <%= f.submit t("comun.cerrar"), class: "btn btn-danger" %>
      <% end %>
    </div>
  </div>
<% end %>

<% if s.diferencias.present? %>
  <div class="mb-4 rounded border-l-4 border-corbata-700 bg-red-50 p-3 text-sm whitespace-pre-line"><strong><%= t("salidas.diferencias_titulo") %></strong>
<%= s.diferencias %></div>
<% end %>

<% if @pedidos&.any? %>
  <div class="mb-4 rounded bg-blue-50 p-3 text-sm">
    <strong><%= t("salidas.pedidos_abiertos_para", destino: s.destino) %></strong>
    <% @pedidos.each do |p| %>
      <span class="ml-2"><%= link_to p.folio, pedido_path(p), class: "chip-folio" %> (<%= p.lineas.map { |l| "#{l.producto.nombre} #{t("salidas.falta")} #{number_with_precision(l.faltante, precision: l.producto.decimales)}" }.join(", ") %>)</span>
    <% end %>
  </div>
<% end %>

<h2 class="mb-2 font-semibold"><%= t("salidas.contenido") %></h2>
<table class="tabla mb-4">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("salidas.grupo") %></th><th class="px-3 py-2"><%= t("salidas.paquete") %></th><th class="px-3 py-2"><%= t("comun.producto") %></th><th class="px-3 py-2 text-right"><%= t("comun.cantidad") %></th><th class="px-3 py-2"><%= t("salidas.verifico") %></th><th class="px-3 py-2"><%= t("salidas.recepcion") %></th></tr></thead>
  <tbody>
    <% @grupos.each do |grupo, filas| %>
      <% filas.each_with_index do |f, i| %>
        <tr class="border-t border-stone-100 <%= { 'recibida' => 'bg-green-50', 'faltante' => 'bg-red-50', 'sobrante' => 'bg-amber-50' }[f.estado] %>">
          <td class="px-3 py-1 font-mono text-xs"><%= i.zero? ? (grupo ? "#{t("etiquetas.tipos.#{grupo.tipo}")} #{grupo.codigo}" : t("salidas.suelto")) : "" %></td>
          <td class="px-3 py-1 font-mono text-xs"><%= f.etiqueta.codigo %></td>
          <td class="px-3 py-1"><%= f.etiqueta.producto.nombre %></td>
          <td class="px-3 py-1 text-right font-mono"><%= cantidad(f.etiqueta.cantidad, f.etiqueta.producto) %></td>
          <td class="px-3 py-1"><%= f.verificado_por || "—" %></td>
          <td class="px-3 py-1"><%= t("estados.#{f.estado}") %><%= " · #{f.motivo}" if f.motivo.present? %></td>
        </tr>
      <% end %>
    <% end %>
    <% s.lineas.includes(:producto, :autorizado_por).each do |l| %>
      <tr class="border-t border-stone-100 bg-amber-50">
        <td class="px-3 py-1 text-xs"><%= t("salidas.manual") %></td><td class="px-3 py-1 text-xs"><%= t("salidas.sin_etiqueta") %></td>
        <td class="px-3 py-1"><%= l.producto.nombre %></td>
        <td class="px-3 py-1 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %></td>
        <td class="px-3 py-1"><%= l.autorizado_por ? "#{t("salidas.autorizo")} #{l.autorizado_por}" : "#{t("salidas.por_revisar")} (#{l.usuario})" %></td>
        <td class="px-3 py-1"><%= t("estados.#{l.rechazada ? "rechazada" : (l.recibida ? "recibida" : "pendiente")}") %> · <%= l.motivo %></td>
      </tr>
    <% end %>
    <% if @filas.empty? && s.lineas.empty? %><tr><td colspan="6" class="px-3 py-4 text-center text-stone-500"><%= t("salidas.vacia") %></td></tr><% end %>
  </tbody>
</table>
<div class="text-sm text-stone-600"><%= t("salidas.totales") %>: <%= s.contenido.map { |p, c| "#{p.nombre} #{cantidad(c, p)}" }.join(" · ") %></div>
<% if s.abierta? && s.sucursal_origen_id == sucursal_actual.id %>
  <%= button_to t("salidas.cancelar_salida"), cancelar_salida_path(s), class: "btn btn-ghost-danger btn-sm mt-4", form: { data: { turbo_confirm: t("salidas.confirmar_cancelar", folio: s.folio) } } %>
<% end %>

<% s = @salida %>
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= { "devolucion" => "Devolución", "reparto" => "Reparto" }.fetch(s.tipo, "Salida") %> <%= s.folio %> · <%= s.sucursal_origen %> → <%= s.destino %><%= " (ruta #{s.ruta})" if s.ruta %></h1>
  <span class="badge"><%= s.estado %></span>
</div>
<p class="mb-4 text-sm text-stone-600">Abrió <%= s.usuario %> el <%= l s.created_at, format: :short %><%= " · verificó #{s.verificado_por}" if s.verificado_por %><%= " · #{s.motivo}" if s.motivo.present? %></p>

<% if s.preparando? && s.sucursal_origen_id == sucursal_actual.id %>
  <div class="mb-4 grid gap-4 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold">Surtir: escanea cajas, tarimas o paquetes</h2>
      <%= render "escaneo", url: agregar_salida_path(s), placeholder: "Código de la etiqueta", boton: "Agregar" %>
      <details class="mt-2 text-sm"><summary class="cursor-pointer text-stone-500">Quitar una etiqueta</summary>
        <%= render "escaneo", url: quitar_salida_path(s), placeholder: "Código de la etiqueta", boton: "Quitar" %></details>
      <% if s.reparto? && (tipos = TipoCanastilla.activos.to_a).any? %>
        <div class="mt-3 text-sm">
          <span class="font-semibold">Canastillas que van:</span> <%= s.canastillas.includes(:tipo_canastilla).map { |c| "#{c.cantidad} #{c.tipo_canastilla}" }.join(", ").presence || "ninguna" %>
          <%= form_with url: canastillas_salida_path(s), class: "mt-1 flex gap-2" do |f| %>
            <%= f.select :tipo_canastilla_id, tipos.map { |t| [ t.to_s, t.id ] }, {}, class: "btn btn-secondary btn-xs" %>
            <%= f.number_field :cantidad, min: 0, placeholder: "cantidad (0 quita)", required: true, class: "w-32 rounded border border-stone-300 px-2 py-1 font-mono" %>
            <%= f.submit "Anotar", class: "btn btn-secondary btn-sm" %>
          <% end %>
        </div>
      <% end %>
      <details class="mt-2 text-sm"><summary class="cursor-pointer text-stone-500">Renglón sin etiqueta (mandar sin escanear, con motivo)</summary>
          <%= form_with url: manual_salida_path(s), class: "mt-2 grid grid-cols-2 gap-2" do |f| %>
            <%= f.select :producto_id, Producto.activos.order(:nombre).map { |p| [ "#{p.nombre} (#{p.unidad})", p.id ] }, {}, class: "col-span-2 rounded border border-stone-300 px-2 py-1" %>
            <%= f.number_field :cantidad, step: "0.001", min: "0.001", placeholder: "cantidad", required: true, class: "rounded border border-stone-300 px-2 py-1 font-mono" %>
            <%= f.text_field :motivo, placeholder: "motivo (se cayó la etiqueta…)", required: true, class: "col-span-2 rounded border border-stone-300 px-2 py-1" %>
            <%= f.submit "Agregar renglón", class: "btn btn-primary btn-sm col-span-2" %>
          <% end %></details>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold">Verificar la carga (otra persona)</h2>
      <% if puede?("salidas.verificar") %>
        <%= render "escaneo", url: verificar_salida_path(s), placeholder: "Escanea lo que sube al camión", boton: "Verificar" %>
        <p class="mt-2 text-sm text-stone-600">Sin verificar: <%= s.sin_verificar.count %> de <%= s.salida_etiquetas.count %></p>
        <%= button_to "Sellar salida", sellar_salida_path(s), class: "mt-2 rounded bg-emerald-700 px-3 py-2 text-white", disabled: s.sin_verificar.exists? || s.salida_etiquetas.none? && s.lineas.none? %>
      <% else %>
        <p class="text-sm text-stone-500">Quien verifica necesita el permiso salidas.verificar.</p>
      <% end %>
      <% if s.sin_verificar.exists? || s.salida_etiquetas.none? %>
        <details class="mt-3 text-sm"><summary class="cursor-pointer text-stone-500">Sellar sin verificar (queda por revisar)</summary>
          <%= form_with url: sellar_salida_path(s), class: "mt-2 flex gap-2" do |f| %>
            <%= f.text_field :motivo_sin_verificar, placeholder: "por qué sale sin el segundo escaneo", required: true, class: "flex-1 rounded border border-stone-300 px-3 py-2" %>
            <%= f.submit "Sellar así", class: "btn btn-warning" %>
          <% end %></details>
      <% end %>
    </div>
  </div>
<% end %>

<% if s.sellada? && s.sucursal_origen_id == sucursal_actual.id %>
  <div class="mb-4 flex items-center gap-3 rounded border-l-4 border-emerald-600 bg-emerald-50 p-3 text-sm">
    Sellada y verificada por <%= s.verificado_por %>. <%= s.reparto? ? "Al enviar se cierra la nota de venta por cobrar y baja el inventario." : "Al enviar baja el inventario de #{s.sucursal_origen}." %>
    <%= button_to "Enviar", enviar_salida_path(s), class: "btn btn-success", form: { data: { turbo_confirm: "¿Enviar la salida #{s.folio}?" } } %>
  </div>
<% end %>

<% if s.reparto? && s.viaje %>
  <p class="mb-4 rounded bg-stone-100 p-3 text-sm">Va en el viaje <%= link_to s.viaje.folio, viaje_path(s.viaje), class: "chip-folio" %> (<%= s.viaje.ruta %>, chofer <%= s.viaje.chofer %>). <%= s.enviada? ? "Se entrega y se cobra en la parada; el dinero entra al liquidar el viaje." : "" %></p>
<% elsif s.reparto? && s.abierta? && puede?("rutas.armar") %>
  <% viajes = Viaje.where(sucursal: s.sucursal_origen, estado: "armando").includes(:ruta, :chofer).order(:fecha) %>
  <div class="mb-4 flex flex-wrap items-center gap-3 rounded bg-stone-100 p-3 text-sm">
    <% if viajes.any? %>
      <%= form_with url: subir_viajes_path, class: "flex flex-wrap items-center gap-2" do |f| %>
        <label>Subir al viaje</label>
        <%= f.select :viaje_id, viajes.map { |v| [ "#{v.folio} · #{v.ruta} · #{v.chofer} · #{l v.fecha}", v.id ] }, { selected: viajes.find { |v| v.ruta_id == s.ruta_id }&.id }, class: "btn btn-secondary btn-xs" %>
        <%= f.hidden_field :salida_id, value: s.id %>
        <%= f.submit "Agregar", class: "btn btn-primary btn-sm" %>
      <% end %>
    <% else %>
      No hay ningún viaje armándose. <%= link_to "Armar viaje de #{s.ruta || 'reparto'}", new_viaje_path(ruta_id: s.ruta_id), class: "btn btn-primary btn-xs" %>
    <% end %>
  </div>
<% end %>
<% if s.reparto? && s.enviada? && s.viaje.nil? && s.sucursal_origen_id == sucursal_actual.id && puede?("caja.vender") %>
  <div class="card mb-4">
    <h2 class="mb-1 font-semibold">Cobrar la entrega · nota <%= link_to s.venta.folio, caja_ticket_path(s.venta), target: "_blank", class: "chip-folio" %> · <%= pesos(s.venta.total_centavos) %></h2>
    <p class="mb-2 text-sm text-stone-600">Lo que trae el chofer entra a la caja abierta. Si el cliente rechazó algo, cobra la nota completa y luego haz la devolución con el ticket.</p>
    <%= form_with url: cobrar_entrega_salida_path(s), class: "flex flex-wrap items-end gap-3 text-sm" do |f| %>
      <div><%= f.label :efectivo, "Efectivo", class: "block" %><%= f.number_field :efectivo, step: "0.01", min: 0, value: s.venta.total_centavos / 100.0, class: "w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono" %></div>
      <div><%= f.label :transferencia, "Transferencia", class: "block" %><%= f.number_field :transferencia, step: "0.01", min: 0, class: "w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono" %></div>
      <div><%= f.label :deposito, "Depósito", class: "block" %><%= f.number_field :deposito, step: "0.01", min: 0, class: "w-32 rounded border border-stone-300 px-2 py-1 text-right font-mono" %></div>
      <%= f.submit "Cobrar entrega", class: "btn btn-success" %>
    <% end %>
  </div>
<% end %>
<% if s.entregada? && s.venta %>
  <p class="mb-4 rounded bg-green-50 p-3 text-sm">Entregada y cobrada: nota <%= link_to s.venta.folio, caja_ticket_path(s.venta), target: "_blank", class: "chip-folio" %> · <%= pesos(s.venta.saldo_centavos) %><%= " (rechazó #{pesos(s.venta.total_devuelto_centavos)})" if s.venta.total_devuelto_centavos.positive? %></p>
<% elsif s.rechazada? && s.venta %>
  <p class="mb-4 rounded bg-red-50 p-3 text-sm">Rechazada completa: la mercancía volvió al inventario y la nota <%= s.venta.folio %> quedó en cero.</p>
<% end %>

<% if @recibiendo %>
  <div class="mb-4 grid gap-4 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold">Recibir: paquete por paquete, o la tarima entera</h2>
      <%= render "escaneo", url: recibir_etiqueta_salida_path(s), placeholder: "Código del paquete o de la tarima", boton: "Recibir" %>
      <% sin_precio = s.contenido.keys.select { |p| p.precio_centavos_en(sucursal_actual).zero? } %>
      <% if sin_precio.any? %>
        <p class="mt-2 rounded bg-amber-50 px-3 py-2 text-sm text-amber-800">Llegan <strong>sin precio</strong> en esta tienda: <%= sin_precio.map(&:nombre).join(", ") %>. Se reciben igual, pero la caja no los vende hasta que la matriz les ponga precio.</p>
      <% end %>
      <details class="mt-2 text-sm"><summary class="cursor-pointer text-stone-500">Llegó un paquete que no viene en la salida (sobrante)</summary>
        <p class="mt-1 text-xs text-stone-500">Se etiquetó por fuera y nunca entró a la salida. Entra a la tienda con motivo y queda por revisar.</p>
        <%= render "escaneo", url: sobrante_salida_path(s), placeholder: "Código del paquete", boton: "Recibir sobrante", motivo: true %>
      </details>
      <p class="mt-2 text-sm text-stone-600">Recibidos <%= @filas.count { |f| f.estado == "recibida" } %> · faltantes <%= @filas.count { |f| f.estado == "faltante" } %> · pendientes <%= @filas.count { |f| f.estado == "pendiente" } %></p>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold">Reportar roto o sin etiqueta</h2>
      <%= render "escaneo", url: reportar_salida_path(s), placeholder: "Código del paquete", boton: "Reportar", motivo: true %>
      <h2 class="mb-2 mt-4 font-semibold">Cerrar recepción</h2>
      <%= form_with url: cerrar_recepcion_salida_path(s), class: "flex gap-2 text-sm", data: { turbo_confirm: "Lo pendiente quedará como faltante. ¿Cerrar?" } do |f| %>
        <%= f.text_field :motivo, placeholder: "motivo para lo pendiente (si queda algo)", class: "flex-1 rounded border border-stone-300 px-3 py-2" %>
        <%= f.submit "Cerrar", class: "btn btn-danger" %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @pedidos&.any? %>
  <div class="mb-4 rounded bg-blue-50 p-3 text-sm">
    <strong>Pedidos abiertos para <%= s.destino %>:</strong>
    <% @pedidos.each do |p| %>
      <span class="ml-2"><%= link_to p.folio, pedido_path(p), class: "chip-folio" %> (<%= p.lineas.map { |l| "#{l.producto.nombre} falta #{number_with_precision(l.faltante, precision: l.producto.decimales)}" }.join(", ") %>)</span>
    <% end %>
  </div>
<% end %>

<h2 class="mb-2 font-semibold">Contenido</h2>
<table class="tabla mb-4">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2">Grupo</th><th class="px-3 py-2">Paquete</th><th class="px-3 py-2">Producto</th><th class="px-3 py-2 text-right">Cantidad</th><th class="px-3 py-2">Verificó</th><th class="px-3 py-2">Recepción</th></tr></thead>
  <tbody>
    <% @grupos.each do |grupo, filas| %>
      <% filas.each_with_index do |f, i| %>
        <tr class="border-t border-stone-100 <%= { 'recibida' => 'bg-green-50', 'faltante' => 'bg-red-50', 'sobrante' => 'bg-amber-50' }[f.estado] %>">
          <td class="px-3 py-1 font-mono text-xs"><%= i.zero? ? (grupo ? "#{grupo.tipo} #{grupo.codigo}" : "suelto") : "" %></td>
          <td class="px-3 py-1 font-mono text-xs"><%= f.etiqueta.codigo %></td>
          <td class="px-3 py-1"><%= f.etiqueta.producto.nombre %></td>
          <td class="px-3 py-1 text-right font-mono"><%= cantidad(f.etiqueta.cantidad, f.etiqueta.producto) %></td>
          <td class="px-3 py-1"><%= f.verificado_por || "—" %></td>
          <td class="px-3 py-1"><%= f.estado %><%= " · #{f.motivo}" if f.motivo.present? %></td>
        </tr>
      <% end %>
    <% end %>
    <% s.lineas.includes(:producto, :autorizado_por).each do |l| %>
      <tr class="border-t border-stone-100 bg-amber-50">
        <td class="px-3 py-1 text-xs">manual</td><td class="px-3 py-1 text-xs">sin etiqueta</td>
        <td class="px-3 py-1"><%= l.producto.nombre %></td>
        <td class="px-3 py-1 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %></td>
        <td class="px-3 py-1"><%= l.autorizado_por ? "autorizó #{l.autorizado_por}" : "por revisar (#{l.usuario})" %></td>
        <td class="px-3 py-1"><%= l.rechazada ? "rechazada" : (l.recibida ? "recibida" : "pendiente") %> · <%= l.motivo %></td>
      </tr>
    <% end %>
    <% if @filas.empty? && s.lineas.empty? %><tr><td colspan="6" class="px-3 py-4 text-center text-stone-500">Vacía.</td></tr><% end %>
  </tbody>
</table>
<div class="text-sm text-stone-600">Totales: <%= s.contenido.map { |p, c| "#{p.nombre} #{cantidad(c, p)}" }.join(" · ") %></div>
<% if s.abierta? && s.sucursal_origen_id == sucursal_actual.id %>
  <%= button_to "Cancelar salida", cancelar_salida_path(s), class: "btn btn-ghost-danger btn-sm mt-4", form: { data: { turbo_confirm: "¿Cancelar #{s.folio}?" } } %>
<% end %>

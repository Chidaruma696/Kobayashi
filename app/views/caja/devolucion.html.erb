<h1 class="mb-4 text-2xl font-bold">Devolución · <%= sucursal_actual %></h1>
<%= form_with url: caja_devolucion_path, method: :get, class: "mb-4 flex gap-2" do |f| %>
  <%= f.text_field :codigo, value: params[:codigo], autofocus: true, autocomplete: "off", placeholder: "Escanea el ticket o la etiqueta del producto", class: "flex-1 rounded border border-slate-300 px-3 py-3 font-mono" %>
  <%= f.submit "Buscar", class: "rounded bg-slate-900 px-4 py-2 text-white" %>
<% end %>
<% if @venta %>
  <%= form_with url: caja_devolver_path, class: "rounded bg-white p-4 shadow-sm" do |f| %>
    <%= f.hidden_field :venta_id, value: @venta.id %>
    <%= f.hidden_field :codigo, value: params[:codigo] %>
    <p class="mb-2 text-sm">Ticket <strong class="font-mono"><%= @venta.folio %></strong> del <%= l @venta.created_at, format: :short %> · <%= pesos(@venta.total_centavos) %> · <%= @venta.estado %></p>
    <table class="w-full text-sm">
      <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Producto</th><th class="px-3 py-2 text-right">Vendido</th><th class="px-3 py-2 text-right">Ya devuelto</th><th class="px-3 py-2 text-right">Precio</th><th class="px-3 py-2">Devolver</th></tr></thead>
      <tbody>
        <% @venta.lineas.includes(:producto, :devolucion_lineas).each do |l| %>
          <tr class="border-t border-slate-100">
            <td class="px-3 py-2"><%= l.producto.nombre %><%= " · #{l.etiqueta.codigo}" if l.etiqueta %></td>
            <td class="px-3 py-2 text-right font-mono"><%= cantidad(l.cantidad, l.producto) %></td>
            <td class="px-3 py-2 text-right font-mono"><%= number_with_precision(l.cantidad_devuelta, precision: l.producto.decimales) %></td>
            <td class="px-3 py-2 text-right font-mono"><%= pesos(l.precio_centavos) %></td>
            <td class="px-3 py-2"><% if l.cantidad_pendiente.positive? %><%= number_field_tag "lineas[#{l.id}]", nil, step: l.producto.kg? ? "0.001" : "1", min: 0, max: l.cantidad_pendiente, class: "w-28 rounded border border-slate-300 px-2 py-1 font-mono" %><% else %><span class="text-slate-400">nada</span><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="mt-3 flex items-end gap-3 text-sm">
      <div class="flex-1"><%= label_tag :motivo, "Motivo", class: "block" %><%= text_field_tag :motivo, nil, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %></div>
      <%= submit_tag "Devolver y regresar el dinero", class: "rounded bg-red-700 px-4 py-2 text-white" %>
    </div>
  <% end %>
<% end %>

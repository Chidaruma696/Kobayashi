<h1 class="mb-4 text-2xl font-bold"><%= t("caja.corte_de_caja") %> · <%= sucursal_actual %></h1>
<% if @corte.nil? %>
  <%= render "sin_caja" %>
<% else %>
  <div class="grid gap-4 sm:grid-cols-4">
    <% [ [ t("caja.fondo"), @corte.fondo_centavos ], [ t("caja.ventas"), @corte.total_ventas_centavos ], [ t("caja.efectivo_de_ventas"), @corte.efectivo_ventas_centavos ], [ t("caja.devoluciones"), -@corte.devoluciones_centavos ], [ t("caja.retiros"), -@corte.retiros_centavos ], [ t("caja.en_gaveta"), @corte.efectivo_esperado_centavos ] ].each do |nombre, monto| %>
      <div class="card"><div class="text-xs uppercase text-stone-500"><%= nombre %></div><div class="font-mono text-2xl"><%= pesos(monto) %></div></div>
    <% end %>
  </div>
  <p class="mt-2 text-sm text-stone-600"><%= t("caja.corte_abierto_por", folio: @corte.folio, quien: @corte.usuario, fecha: l(@corte.abierto_en, format: :short)) %> · <%= t("caja.n_ventas", count: @corte.ventas.count) %></p>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("caja.retiro_caja_fuerte") %></h2>
      <%= form_with url: caja_retirar_path, class: "space-y-2 text-sm" do |f| %>
        <%= f.number_field :monto, step: "0.01", min: "0.01", placeholder: t("caja.monto"), required: true, class: "w-full rounded border border-stone-300 px-3 py-2 font-mono" %>
        <%= f.text_field :motivo, placeholder: t("comun.motivo"), required: true, class: "w-full rounded border border-stone-300 px-3 py-2" %>
        <% unless puede?("caja.retirar") %><p class="text-xs text-stone-600"><%= t("caja.retiro_por_revisar") %></p><% end %>
        <%= f.submit t("caja.retirar"), class: "btn btn-primary" %>
      <% end %>
      <% if @corte.retiros.any? %>
        <ul class="mt-3 text-sm">
          <% @corte.retiros.includes(:usuario, :autorizado_por).each do |r| %>
            <li class="border-t border-stone-100 py-1"><%= l r.created_at, format: :short %> · <span class="font-mono"><%= pesos(r.monto_centavos) %></span> · <%= r.motivo %> · <%= t("salidas.autorizo") %> <%= r.autorizado_por %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <div class="card">
      <h2 class="mb-2 font-semibold"><%= t("caja.cerrar_corte") %></h2>
      <p class="mb-2 text-sm text-stone-600"><%= t("caja.cerrar_corte_ayuda") %></p>
      <%= form_with url: caja_cerrar_path, class: "flex items-end gap-3 text-sm", data: { turbo_confirm: t("caja.confirmar_cerrar_corte", folio: @corte.folio) } do |f| %>
        <div><%= f.label :contado, t("caja.efectivo_contado"), class: "block" %><%= f.number_field :contado, step: "0.01", min: 0, required: true, class: "rounded border border-stone-300 px-3 py-2 font-mono" %></div>
        <%= f.submit t("caja.cerrar_corte"), class: "btn btn-danger" %>
      <% end %>
    </div>
  </div>
<% end %>
<% if @cortes.any? %>
  <h2 class="mb-2 mt-8 font-semibold"><%= t("caja.cortes_cerrados") %></h2>
  <table class="tabla">
    <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("comun.folio") %></th><th class="px-3 py-2"><%= t("caja.abierto") %></th><th class="px-3 py-2"><%= t("caja.cerrado") %></th><th class="px-3 py-2"><%= t("caja.cajero") %></th><th class="px-3 py-2 text-right"><%= t("caja.esperado") %></th><th class="px-3 py-2 text-right"><%= t("caja.contado") %></th><th class="px-3 py-2 text-right"><%= t("caja.diferencia") %></th></tr></thead>
    <tbody>
      <% @cortes.each do |c| %>
        <tr class="border-t border-stone-100">
          <td class="px-3 py-2 font-mono"><%= c.folio %></td>
          <td class="px-3 py-2"><%= l c.abierto_en, format: :short %></td>
          <td class="px-3 py-2"><%= l(c.cerrado_en, format: :short) if c.cerrado_en %></td>
          <td class="px-3 py-2"><%= c.usuario %></td>
          <td class="px-3 py-2 text-right font-mono"><%= pesos(c.esperado_centavos) %></td>
          <td class="px-3 py-2 text-right font-mono"><%= pesos(c.contado_centavos) %></td>
          <td class="px-3 py-2 text-right font-mono <%= c.diferencia_centavos.to_i.negative? ? 'text-red-700' : 'text-green-700' %>"><%= pesos(c.diferencia_centavos) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

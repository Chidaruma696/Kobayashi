<% if @corte.nil? %>
  <%= render "sin_caja" %>
<% else %>
  <% if @corte.excede_limite? %>
    <div class="mb-4 rounded border-l-4 border-red-600 bg-red-50 p-3 text-sm">Hay más de <%= pesos(sucursal_actual.limite_efectivo_centavos) %> en la gaveta: <%= link_to "haz un retiro a la caja fuerte", caja_corte_path, class: "underline" %> antes de seguir vendiendo.</div>
  <% end %>
  <div class="grid gap-4 lg:grid-cols-3" data-controller="pos" data-pos-escanear-url-value="<%= caja_escanear_path %>" data-pos-cobrar-url-value="<%= caja_cobrar_path %>" data-pos-clave-value="<%= @clave %>">
    <div class="lg:col-span-2">
      <div class="mb-3 flex gap-3">
        <input data-pos-target="codigo" data-action="keydown.enter->pos#escanear" autofocus autocomplete="off" placeholder="Escanea la etiqueta o teclea PLU / clave y Enter" class="flex-1 rounded border border-slate-300 px-3 py-3 font-mono text-lg">
        <div data-controller="bascula" data-bascula-auto-value="false" class="flex items-center gap-2 rounded bg-white px-3 shadow-sm">
          <span class="text-xs text-slate-500" data-bascula-target="estado">báscula</span>
          <span class="font-mono text-2xl" data-bascula-target="peso">0.000</span>
          <input type="hidden" data-bascula-target="cantidad" data-pos-target="peso">
          <button type="button" data-action="bascula#conectar" class="rounded bg-slate-200 px-2 py-1 text-xs">conectar</button>
        </div>
      </div>
      <div id="aviso" data-pos-target="aviso" class="mb-2 empty:hidden rounded bg-red-50 px-3 py-2 text-sm text-red-800"></div>
      <div data-pos-target="pendiente" class="mb-2 hidden rounded bg-blue-50 p-3 text-sm">
        <span data-pos-target="pendienteNombre" class="font-semibold"></span> ·
        cantidad <input data-pos-target="pendienteCantidad" data-action="keydown.enter->pos#confirmarPendiente" type="number" step="0.001" min="0.001" class="w-28 rounded border border-slate-300 px-2 py-1 font-mono">
        <button type="button" data-action="pos#usarBascula" class="rounded bg-slate-200 px-2 py-1">usar báscula</button>
        <button type="button" data-action="pos#confirmarPendiente" class="rounded bg-slate-900 px-2 py-1 text-white">agregar</button>
        <button type="button" data-action="pos#cancelarPendiente" class="px-2 py-1 text-slate-500">cancelar</button>
      </div>
      <table class="w-full bg-white text-sm shadow-sm">
        <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Producto</th><th class="px-3 py-2 text-right">Cantidad</th><th class="px-3 py-2 text-right">Precio</th><th class="px-3 py-2 text-right">Importe</th><th></th></tr></thead>
        <tbody data-pos-target="cuerpo"></tbody>
      </table>
    </div>
    <div class="rounded bg-white p-4 shadow-sm">
      <div class="text-xs uppercase text-slate-500">Total</div>
      <div class="mb-4 font-mono text-4xl" data-pos-target="total">$0.00</div>
      <div class="space-y-2 text-sm">
        <label class="flex items-center justify-between gap-2">Efectivo <input data-pos-target="efectivo" data-action="input->pos#recalcular" type="number" step="0.01" min="0" class="w-32 rounded border border-slate-300 px-2 py-1 text-right font-mono"></label>
        <label class="flex items-center justify-between gap-2">Transferencia <input data-pos-target="transferencia" data-action="input->pos#recalcular" type="number" step="0.01" min="0" class="w-32 rounded border border-slate-300 px-2 py-1 text-right font-mono"></label>
        <label class="flex items-center justify-between gap-2">Depósito <input data-pos-target="deposito" data-action="input->pos#recalcular" type="number" step="0.01" min="0" class="w-32 rounded border border-slate-300 px-2 py-1 text-right font-mono"></label>
        <div class="flex items-center justify-between border-t border-slate-200 pt-2">Cambio <span class="font-mono text-xl" data-pos-target="cambio">$0.00</span></div>
        <label class="flex items-center justify-between gap-2 text-slate-500">PIN (si bajaste un precio) <input data-pos-target="pin" type="password" inputmode="numeric" autocomplete="off" class="w-24 rounded border border-slate-300 px-2 py-1"></label>
      </div>
      <button type="button" data-action="pos#cobrar" data-pos-target="botonCobrar" class="mt-4 w-full rounded bg-emerald-700 px-4 py-3 text-lg font-semibold text-white hover:bg-emerald-600">Cobrar</button>
      <button type="button" data-action="pos#vaciar" class="mt-2 w-full rounded border border-slate-300 px-4 py-2 text-sm">Vaciar ticket</button>
      <p class="mt-3 text-xs text-slate-500">Corte <%= @corte.folio %> · en gaveta <%= pesos(@corte.efectivo_esperado_centavos) %></p>
    </div>
  </div>
<% end %>

<div class="ticket">
  <div class="centro"><strong><%= Ajuste["negocio.nombre"].presence || @venta.sucursal.nombre %></strong><% if Ajuste["negocio.nombre"].present? %><br><%= @venta.sucursal.nombre %><% end %><% if Ajuste["negocio.direccion"].present? %><br><%= Ajuste["negocio.direccion"] %><% end %><% if Ajuste["negocio.telefono"].present? %><br><%= Ajuste["negocio.telefono"] %><% end %><br><%= @venta.folio %> · <%= l @venta.created_at, format: :short %><br><%= t("caja.le_atendio") %> <%= @venta.usuario.nombre %><% if @venta.cliente %><br><%= t("caja.cliente") %>: <%= @venta.cliente.nombre %><% end %></div>
  <div class="linea"></div>
  <table>
    <% @venta.lineas.each do |l| %>
      <tr><td colspan="2"><%= l.producto.nombre %><%= " (#{l.promocion.nombre})" if l.promocion %></td></tr>
      <tr><td><%= cantidad(l.cantidad, l.producto) %> × <%= pesos(l.precio_centavos) %><%= " *" if l.precio_centavos < l.catalogo_centavos %></td><td class="der"><%= pesos(l.importe_centavos) %></td></tr>
    <% end %>
  </table>
  <div class="linea"></div>
  <table>
    <tr><td class="total"><%= t("comun.total").upcase %></td><td class="der total"><%= pesos(@venta.total_centavos) %></td></tr>
    <% @venta.pagos.each do |p| %><tr><td><%= t("formas_pago.#{p.forma}") %></td><td class="der"><%= pesos(p.monto_centavos) %></td></tr><% end %>
    <tr><td><%= t("caja.cambio") %></td><td class="der"><%= pesos(@venta.cambio_centavos) %></td></tr>
  </table>
  <% if @venta.estado == "devuelta" %><div class="centro"><strong><%= t("estados.devuelta").upcase %></strong></div><% end %>
  <% if @venta.por_cobrar? %><div class="centro"><strong><%= t("caja.por_cobrar_contra_entrega") %></strong></div><% end %>
  <div class="linea"></div>
  <div class="centro"><%= t("caja.devoluciones_solo_con_ticket") %></div>
  <%= ean13_svg(@venta.codigo, alto: 34, modulo: 2) %>
  <% if Ajuste["negocio.pie_ticket"].present? %><div class="centro"><%= Ajuste["negocio.pie_ticket"] %></div><% end %>
</div>

<% c = @cliente %>
<div class="mb-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= c.nombre %></h1>
  <%= link_to "← Cobranza", cobranza_path, class: "text-sm text-blue-700 underline" %>
</div>
<p class="mb-4 text-sm text-slate-600"><%= c.ruta %><%= " · #{c.telefono}" if c.telefono.present? %> · <%= Credito::TIPOS[c.credito] %><%= " · límite #{pesos(c.limite_credito_centavos)}" if c.credito == "limite" %><%= " · corte los #{Credito::DIAS[c.dia_corte]}" if c.dia_corte %> · <%= link_to "editar", edit_admin_cliente_path(c), class: "text-blue-700 underline" if puede?("admin.catalogo") %></p>

<div class="mb-4 grid gap-4 md:grid-cols-3">
  <div class="rounded bg-white p-4 shadow-sm">
    <div class="text-xs uppercase text-slate-500">Saldo</div>
    <div class="font-mono text-3xl"><%= pesos(@estado.saldo_centavos) %></div>
    <div class="mt-2 text-sm <%= @estado.bloqueado ? 'text-red-700' : 'text-green-700' %>"><%= @estado.bloqueado ? "Crédito bloqueado" : (@estado.tipo == "contado" ? "Sin crédito" : "Crédito abierto") %><%= " (manual)" if @estado.manual %></div>
    <div class="text-xs text-slate-500"><%= @estado.regla %><%= ". #{@estado.motivo}" if @estado.motivo.present? %></div>
    <table class="mt-3 w-full text-xs text-slate-600">
      <% @aging.each do |k, v| %><tr><td><%= k %> días</td><td class="text-right font-mono"><%= pesos(v) %></td></tr><% end %>
    </table>
  </div>
  <% if puede?("cobranza.abonar") %>
    <div class="rounded bg-white p-4 shadow-sm">
      <h2 class="mb-2 font-semibold">Abono en oficina</h2>
      <p class="mb-2 text-xs text-slate-500">Entra a la caja abierta de <%= sucursal_actual %>.</p>
      <%= form_with url: cobranza_abonar_path(c), class: "space-y-2 text-sm" do |f| %>
        <%= f.number_field :monto, step: "0.01", min: "0.01", placeholder: "Monto", required: true, class: "w-full rounded border border-slate-300 px-3 py-2 font-mono" %>
        <%= f.select :forma, Pago::FORMAS.map { |x| [ x.humanize, x ] }, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
        <%= f.text_field :notas, placeholder: "notas", class: "w-full rounded border border-slate-300 px-3 py-2" %>
        <%= f.submit "Abonar", class: "rounded bg-emerald-700 px-4 py-2 text-white" %>
      <% end %>
    </div>
  <% end %>
  <% if puede?("cobranza.bloquear") %>
    <div class="rounded bg-white p-4 shadow-sm">
      <h2 class="mb-2 font-semibold">Bloqueo manual</h2>
      <% if c.bloqueo_manual %><p class="mb-2 text-xs text-slate-600">Hoy: <strong><%= c.bloqueo_manual %></strong> por <%= c.bloqueo_por %> · <%= c.bloqueo_motivo %></p><% end %>
      <%= form_with url: cobranza_bloquear_path(c), class: "space-y-2 text-sm" do |f| %>
        <%= f.text_field :motivo, placeholder: "motivo", class: "w-full rounded border border-slate-300 px-3 py-2" %>
        <div class="flex flex-wrap gap-2">
          <%= f.button "Bloquear", name: "accion", value: "bloquear", class: "rounded border border-red-400 px-3 py-1 text-red-700" %>
          <%= f.button "Desbloquear", name: "accion", value: "desbloquear", class: "rounded border border-green-500 px-3 py-1 text-green-700" %>
          <%= f.button "Quitar manual", name: "accion", value: "quitar", class: "rounded border border-slate-300 px-3 py-1" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<h2 class="mb-2 font-semibold">Estado de cuenta</h2>
<table class="w-full border-collapse bg-white text-sm shadow-sm">
  <thead class="bg-slate-200 text-left"><tr><th class="px-3 py-2">Fecha</th><th class="px-3 py-2">Movimiento</th><th class="px-3 py-2">Detalle</th><th class="px-3 py-2 text-right">Cargo</th><th class="px-3 py-2 text-right">Abono</th><th class="px-3 py-2">Quién</th></tr></thead>
  <tbody>
    <% @movimientos.each do |m| %>
      <tr class="border-t border-slate-100">
        <td class="px-3 py-1 whitespace-nowrap"><%= l m.fecha %></td>
        <td class="px-3 py-1"><%= m.tipo %></td>
        <td class="px-3 py-1 text-slate-600"><%= m.motivo %></td>
        <td class="px-3 py-1 text-right font-mono"><%= pesos(m.monto_centavos) if m.monto_centavos.positive? %></td>
        <td class="px-3 py-1 text-right font-mono text-green-700"><%= pesos(-m.monto_centavos) if m.monto_centavos.negative? %></td>
        <td class="px-3 py-1"><%= m.usuario %></td>
      </tr>
    <% end %>
    <% if @movimientos.empty? %><tr><td colspan="6" class="px-3 py-6 text-center text-slate-500">Sin movimientos.</td></tr><% end %>
  </tbody>
</table>

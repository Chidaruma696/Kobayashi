<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t("cobranza.cobranza_de_ruta") %></h1>
  <span class="text-sm text-stone-600"><%= t("cobranza.saldo_en_la_calle") %>: <strong class="font-mono"><%= pesos(@total) %></strong></span>
</div>
<p class="mb-4 text-sm text-stone-600"><%= t("cobranza.intro") %></p>
<table class="tabla">
  <thead class="bg-stone-200 text-left"><tr><th class="px-3 py-2"><%= t("caja.cliente") %></th><th class="px-3 py-2"><%= t("salidas.ruta") %></th><th class="px-3 py-2"><%= t("cobranza.credito") %></th><th class="px-3 py-2 text-right"><%= t("cobranza.saldo") %></th><th class="px-3 py-2 text-right">0-30</th><th class="px-3 py-2 text-right">31-60</th><th class="px-3 py-2 text-right">61-90</th><th class="px-3 py-2 text-right">90+</th><th class="px-3 py-2"><%= t("comun.estado") %></th></tr></thead>
  <tbody>
    <% @clientes.each do |c, e, a| %>
      <tr class="border-t border-stone-100 <%= 'bg-red-50' if e.bloqueado %>">
        <td class="px-3 py-2"><%= link_to c.nombre, cobranza_cliente_path(c), class: "enlace" %></td>
        <td class="px-3 py-2"><%= c.ruta %></td>
        <td class="px-3 py-2"><%= Credito.nombre(c.credito) %></td>
        <td class="px-3 py-2 text-right font-mono"><%= pesos(e.saldo_centavos) %></td>
        <% a.each_value do |v| %><td class="px-3 py-2 text-right font-mono text-stone-600"><%= v.zero? ? "" : pesos(v) %></td><% end %>
        <td class="px-3 py-2 <%= e.bloqueado ? 'text-red-700' : 'text-green-700' %>"><%= e.bloqueado ? t("estados.bloqueado") : (e.tipo == "contado" ? t("cobranza.contado") : t("cobranza.abierto")) %><%= " (#{t("cobranza.manual")})" if e.manual %><% if e.motivo.present? %><div class="text-xs text-stone-500"><%= e.motivo %></div><% end %></td>
      </tr>
    <% end %>
    <% if @clientes.empty? %><tr><td colspan="9" class="px-3 py-6 text-center text-stone-500"><%= t("cobranza.nadie_debe") %></td></tr><% end %>
  </tbody>
</table>
